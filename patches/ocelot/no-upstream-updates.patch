From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rumisle <why-excuse-quail@duck.com>
Date: Fri, 25 Sep 2026 12:25:13 +0800
Subject: cli/updater: never update from upstream OpenCode

Upstream releases would replace an ocelot build with stock OpenCode, so the
background update check is skipped and `upgrade` points at ocelot releases.

Ocelot-Patch: ocelot/no-upstream-updates

diff --git a/packages/cli/src/commands/handlers/upgrade.ts b/packages/cli/src/commands/handlers/upgrade.ts
index fecd62d57..05861f2a7 100644
--- a/packages/cli/src/commands/handlers/upgrade.ts
+++ b/packages/cli/src/commands/handlers/upgrade.ts
@@ -4,7 +4,7 @@ import { Commands } from "../commands"
 import { Runtime } from "../../framework/runtime"
 import { Updater } from "../../services/updater"
 import { handlePromptErrors } from "../../ui/prompt"
-import { OPENCODE_VERSION } from "../../version"
+import { OPENCODE_CHANNEL, OPENCODE_VERSION } from "../../version"
 import { stripVTControlCharacters } from "node:util"
 
 export default Runtime.handler(
@@ -12,6 +12,10 @@ export default Runtime.handler(
   Effect.fn("cli.upgrade")(
     function* (input) {
       intro("Upgrade")
+      if (OPENCODE_CHANNEL === "ocelot")
+        return yield* Effect.fail(
+          new Error("Ocelot does not update from upstream OpenCode. Get new builds from https://github.com/rumisle/ocelot/releases."),
+        )
       const updater = yield* Updater.Service
       const method = Option.getOrUndefined(input.method) ?? (yield* updater.method())
       if (!method)
diff --git a/packages/cli/src/services/updater.ts b/packages/cli/src/services/updater.ts
index 20828386c..8ace05256 100644
--- a/packages/cli/src/services/updater.ts
+++ b/packages/cli/src/services/updater.ts
@@ -425,9 +425,10 @@ const make = Effect.gen(function* () {
   })
 
   const inspect = Effect.fnUntraced(function* () {
-    if (OPENCODE_LOCAL || ["1", "true"].includes(process.env.OPENCODE_DISABLE_AUTOUPDATE?.toLowerCase() ?? "")) {
+    // ocelot: upstream releases would replace this build with stock OpenCode.
+    if (OPENCODE_LOCAL || OPENCODE_CHANNEL === "ocelot" || ["1", "true"].includes(process.env.OPENCODE_DISABLE_AUTOUPDATE?.toLowerCase() ?? "")) {
       yield* Effect.logInfo("update check skipped", {
-        reason: OPENCODE_LOCAL ? "local-install" : "disabled",
+        reason: OPENCODE_LOCAL ? "local-install" : OPENCODE_CHANNEL === "ocelot" ? "ocelot" : "disabled",
         version: OPENCODE_VERSION,
         channel: OPENCODE_CHANNEL,
       })
@@ -472,6 +473,11 @@ const make = Effect.gen(function* () {
   })
 
   const check = Effect.fn("cli.updater.check")(function* () {
+    if (OPENCODE_CHANNEL === "ocelot")
+      return {
+        type: "unavailable" as const,
+        message: "Ocelot does not update from upstream OpenCode. Get new builds from https://github.com/rumisle/ocelot/releases.",
+      }
     if (OPENCODE_LOCAL)
       return {
         type: "unavailable" as const,
