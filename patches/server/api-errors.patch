+/**
+ * ocelot: an API request that fails without a response of its own (a defect, an unknown route)
+ * answers with a JSON error, like the declared ones, instead of an empty 500/404 the client can
+ * only report as "UnsupportedContentType". Defects are logged at ERROR.
+ */
+export const apiErrors = (app: App): App =>
+  Effect.gen(function* () {
+    const exit = yield* Effect.exit(app)
+    const request = yield* HttpServerRequest.HttpServerRequest
+    const path = new URL(request.url, "http://localhost").pathname
+    const response = Exit.isSuccess(exit) ? exit.value : (yield* HttpServerError.causeResponse(exit.cause))[0]
+    if (!path.startsWith("/api/") || response.body._tag !== "Empty" || (response.status !== 404 && response.status !== 500))
+      return yield* exit
+    const route = `${request.method} ${path}`
+    if (response.status === 404) {
+      yield* Effect.logWarning("no such route", { route })
+      return HttpServerResponse.jsonUnsafe(
+        { _tag: "RouteNotFound", message: `No such route: ${route}` },
+        { status: 404, headers: response.headers },
+      )
+    }
+    const error = Exit.isFailure(exit) ? Cause.squash(exit.cause) : undefined
+    const reason = error instanceof Error ? error.message : error === undefined ? "internal error" : String(error)
+    if (Exit.isFailure(exit)) yield* Effect.logError("request failed", { route, cause: Cause.pretty(exit.cause) })
+    return HttpServerResponse.jsonUnsafe(
+      { _tag: "InternalServerError", message: `${route} failed: ${reason.split("\n", 1)[0]!.slice(0, 500)}` },
+      { status: 500, headers: response.headers },
+    )
+  })
+
