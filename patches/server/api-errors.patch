@@ -0,0 +1,49 @@
+import { expect, test } from "bun:test"
+import { Effect, Exit } from "effect"
+import { HttpServerError, HttpServerRequest, HttpServerResponse } from "effect/unstable/http"
+import { apiErrors } from "../src/process"
+
+const run = (path: string, app: Effect.Effect<HttpServerResponse.HttpServerResponse, unknown, any>) =>
+  Effect.runPromise(
+    apiErrors(app).pipe(
+      Effect.provideService(HttpServerRequest.HttpServerRequest, HttpServerRequest.fromWeb(new Request(`http://localhost${path}`))),
+      Effect.scoped,
+      Effect.exit,
+      Effect.map((exit) => (Exit.isSuccess(exit) ? exit.value : HttpServerError.exitResponse(exit))),
+      Effect.map((response) => HttpServerResponse.toWeb(response)),
+      Effect.flatMap((response) =>
+        Effect.promise(async () => ({
+          status: response.status,
+          type: response.headers.get("content-type"),
+          body: await response.text(),
+        })),
+      ),
+    ),
+  )
+
+test("a defect answers with a JSON error that names the request and the cause", async () => {
+  const response = await run("/api/session/ses_x/message", Effect.die(new Error("database disk image is malformed\nstack")))
+  expect(response.status).toBe(500)
+  expect(response.type).toBe("application/json")
+  expect(JSON.parse(response.body)).toEqual({
+    _tag: "InternalServerError",
+    message: "GET /api/session/ses_x/message failed: database disk image is malformed",
+  })
+})
+
+test("an unknown route answers with a JSON error", async () => {
+  const response = await run("/api/nope", Effect.succeed(HttpServerResponse.empty({ status: 404 })))
+  expect(response.status).toBe(404)
+  expect(JSON.parse(response.body)).toEqual({ _tag: "RouteNotFound", message: "No such route: GET /api/nope" })
+})
+
+test("responses with a body, and requests outside /api, are left alone", async () => {
+  const declared = HttpServerResponse.jsonUnsafe({ _tag: "SessionNotFoundError" }, { status: 404 })
+  expect(await run("/api/session/ses_x", Effect.succeed(declared))).toEqual({
+    status: 404,
+    type: "application/json",
+    body: '{"_tag":"SessionNotFoundError"}',
+  })
+  expect((await run("/assets/x.js", Effect.die(new Error("boom")))).body).toBe("")
+  expect((await run("/api/ok", Effect.succeed(HttpServerResponse.empty({ status: 204 })))).status).toBe(204)
+})
