index a0457753fea9b135a60d6b50872be1a90f70f019..d1472b6e8236ccc65244711d771f885e44ee7ab3 100644
--- a/packages/client/src/promise/generated/client.ts
+++ b/packages/client/src/promise/generated/client.ts
@@ -2254,7 +2254,7 @@ async function json(response: Response): Promise<unknown> {
     try {
       await response.body?.cancel()
     } catch {}
-    throw new ClientError("UnsupportedContentType", { detail: response.headers.get("content-type") })
+    throw new ClientError("UnsupportedContentType", { detail: describe(response) })
   }
   let text: string
   try {
@@ -2283,6 +2283,16 @@ function declared(body: DeclaredErrorBody) {
   return error
 }
 
+// ocelot: name the request, so an error without a JSON body still says where it came from.
+function describe(response: Response) {
+  const type = response.headers.get("content-type") ?? "no content-type"
+  let path = response.url
+  try {
+    path = new URL(response.url).pathname
+  } catch {}
+  return path ? `${type} (${response.status} ${path})` : `${type} (${response.status})`
+}
+
 function isContentType(response: Response, expected: string) {
   return response.headers.get("content-type")?.split(";", 1)[0]?.trim().toLowerCase() === expected
 }
