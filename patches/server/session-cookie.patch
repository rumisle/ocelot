+it.live("the web app's own authenticated requests get the session cookie, so links it opens work", () =>
+  Effect.gen(function* () {
+    const server = yield* ServerProcess.start<never, never>({
+      hostname: "127.0.0.1",
+      port: 0,
+      password: "secret",
+      app: { version: "test-version" },
+      database: { path: ":memory:" },
+    })
+    const base = HttpServer.formatAddress(server.address)
+    const request = (headers: Record<string, string>) =>
+      Effect.promise(() => fetch(new URL("/api/session/active", base), { redirect: "manual", headers }))
+    const basic = `Basic ${btoa("opencode:secret")}`
+
+    // A page load (a file link) without the header is challenged.
+    expect((yield* request({ "sec-fetch-mode": "navigate" })).status).toBe(401)
+
+    const app = yield* request({ authorization: basic, "sec-fetch-site": "same-origin", "sec-fetch-mode": "cors" })
+    expect(app.status).toBe(200)
+    const setCookie = app.headers.get("set-cookie") ?? ""
+    expect(setCookie).toContain(`opencode_session_${new URL(base).port}=`)
+    expect(setCookie).toContain("HttpOnly")
+    expect(setCookie).toContain("SameSite=Lax")
+    const cookie = setCookie.split(";")[0]!
+    expect((yield* request({ cookie, "sec-fetch-mode": "navigate" })).status).toBe(200)
+
+    // Only while the cookie is missing or invalid, only for same-origin pages, never for bad credentials.
+    const again = yield* request({ authorization: basic, cookie, "sec-fetch-site": "same-origin" })
+    expect(again.headers.get("set-cookie")).toBeNull()
+    expect((yield* request({ authorization: basic, "sec-fetch-site": "cross-site" })).headers.get("set-cookie")).toBeNull()
+    expect((yield* request({ authorization: basic })).headers.get("set-cookie")).toBeNull()
+    const wrong = yield* request({ authorization: `Basic ${btoa("opencode:nope")}`, "sec-fetch-site": "same-origin" })
+    expect(wrong.status).toBe(401)
+    expect(wrong.headers.get("set-cookie")).toBeNull()
+  }),
+)
