@@ -5,7 +5,7 @@ export { Authorization } from "@opencode/protocol/middleware/authorization"
 import { hasPtyConnectTicketURL } from "@opencode/protocol/groups/pty"
 import { hasPersistentPtyConnectTicketURL } from "@opencode/protocol/groups/persistent-pty"
 import { isPairingConnectURL } from "@opencode/protocol/groups/server"
-import { Effect, Encoding, Layer, Redacted } from "effect"
+import { Duration, Effect, Encoding, Layer, Redacted } from "effect"
 import { HttpEffect, HttpServerRequest, HttpServerResponse } from "effect/unstable/http"
 
 const AUTH_TOKEN_QUERY = "auth_token"
@@ -69,6 +69,13 @@ function authorizedSessionCookie(request: HttpServerRequest.HttpServerRequest, c
   return ServerAuth.verifySession(token, config)
 }
 
+// ocelot: the web app authenticates with a header, which page loads can't send, so links it opens
+// (a file under /api/fs/read, a download) asked for the password. Its own requests that pass with
+// the password or a pairing token also get the session cookie a pairing link sets, so those work.
+function needsSessionCookie(request: HttpServerRequest.HttpServerRequest, config: ServerAuth.Info) {
+  return request.headers["sec-fetch-site"] === "same-origin" && !authorizedSessionCookie(request, config)
+}
+
 export const authorizationLayer = Layer.effect(
   Authorization,
   Effect.gen(function* () {
@@ -82,7 +89,23 @@ export const authorizationLayer = Layer.effect(
         const url = new URL(request.url, "http://localhost")
         if (hasPtyConnectTicketURL(url) || hasPersistentPtyConnectTicketURL(url) || isPairingConnectURL(url))
           return yield* effect
-        if (yield* authorizedRequest(request, config)) return yield* effect
+        if (yield* authorizedRequest(request, config)) {
+          if (needsSessionCookie(request, config)) {
+            const token = ServerAuth.issueSession(config)
+            if (token !== undefined)
+              yield* HttpEffect.appendPreResponseHandler((_request, response) =>
+                Effect.succeed(
+                  HttpServerResponse.setCookieUnsafe(response, ServerAuth.sessionCookieName(request.headers.host), token, {
+                    path: "/",
+                    httpOnly: true,
+                    sameSite: "lax",
+                    maxAge: Duration.seconds(ServerAuth.SESSION_TTL_SECONDS),
+                  }),
+                ),
+              )
+          }
+          return yield* effect
+        }
         if (challengeRequest(request))
           yield* HttpEffect.appendPreResponseHandler((_request, response) =>
             Effect.succeed(HttpServerResponse.setHeader(response, "www-authenticate", WWW_AUTHENTICATE)),
