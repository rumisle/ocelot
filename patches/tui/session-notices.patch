From: rumisle <why-excuse-quail@duck.com>
Date: Sat, 26 Sep 2026 00:49:00 +0800
Subject: tui/session: plugin notices

Plugin notices (patch core/session-notices) render as a notice row, warnings in the
warning color, and live updates append them.

Ocelot-Patch: tui/session-notices

diff --git a/packages/tui/src/routes/session/index.tsx b/packages/tui/src/routes/session/index.tsx
index d20d92f42aec388ac0a03d70ca7ddd27357c586e..9579b165eabcecbb607296e160ddec031e71d1ff 100644
--- a/packages/tui/src/routes/session/index.tsx
+++ b/packages/tui/src/routes/session/index.tsx
@@ -1811,7 +1811,12 @@ function SessionMessageView(props: { message: SessionMessageInfo }) {
         <SessionSwitchMessageV2 message={props.message} />
       </Match>
       <Match
-        when={props.message.type === "system" || props.message.type === "synthetic" || props.message.type === "skill"}
+        when={
+          props.message.type === "system" ||
+          props.message.type === "synthetic" ||
+          props.message.type === "skill" ||
+          props.message.type === "notice"
+        }
       >
         <Show when={props.message.type === "skill"} fallback={<SessionNoticeMessageV2 message={props.message} />}>
           <SessionSkillMessage message={props.message as Extract<SessionMessageInfo, { type: "skill" }>} />
@@ -1959,6 +1964,7 @@ function SessionNoticeMessageV2(props: { message: SessionMessageInfo }) {
   const text = () => {
     if (props.message.type === "system") return props.message.description ?? "Instructions updated"
     if (props.message.type === "synthetic") return props.message.description ?? ""
+    if (props.message.type === "notice") return props.message.text
     return ""
   }
   const description = () => (source() === "shell" ? text().replace(/\s+/g, " ").trim() : text())
@@ -1979,7 +1985,16 @@ function SessionNoticeMessageV2(props: { message: SessionMessageInfo }) {
     <Show
       when={completion()}
       fallback={
-        <InlineToolRow icon="◈" color={theme.text.muted} pending="Notice" complete={true}>
+        <InlineToolRow
+          icon="◈"
+          color={
+            props.message.type === "notice" && props.message.level === "warning"
+              ? theme.text.feedback.warning.base
+              : theme.text.muted
+          }
+          pending="Notice"
+          complete={true}
+        >
           {text()}
         </InlineToolRow>
       }
diff --git a/packages/tui/src/routes/session/rows.ts b/packages/tui/src/routes/session/rows.ts
index 8160e4ae5fc702d7cfccc2038d969627a1cac398..ae2c884801d2807dfde9936eed527372d6ff5a05 100644
--- a/packages/tui/src/routes/session/rows.ts
+++ b/packages/tui/src/routes/session/rows.ts
@@ -257,6 +257,10 @@ export function createSessionRows(sessionID: Accessor<string>, onSynced?: (sessi
         appendMessage(event.id.replace(/^evt_/, "msg_"))
     }),
     data.on("session.shell.started", message),
+    // ocelot: plugin notices carry their own id (re-publishing replaces the notice).
+    data.on("session.notice", (event) => {
+      if (event.data.sessionID === sessionID()) appendMessage(event.data.id)
+    }),
     data.on("session.agent.selected", message),
     data.on("session.model.selected", message),
     data.on("session.text.delta", (event) => {
