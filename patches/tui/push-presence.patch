diff --git a/packages/tui/src/context/push-presence.tsx b/packages/tui/src/context/push-presence.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..4247c73dd540ab5c73074dd717583bb1b27e62c9
--- /dev/null
+++ b/packages/tui/src/context/push-presence.tsx
@@ -0,0 +1,63 @@
+import { Service, type Endpoint } from "@opencode/client/effect/service"
+import { useKeyboard, usePaste, useRenderer } from "@opentui/solid"
+import { randomUUID } from "node:crypto"
+import { onCleanup } from "solid-js"
+
+// ocelot: tells the server's Web Push (packages/cli/src/services/web-push.ts) whether this TUI is in
+// use, like the web app does: nothing is pushed to a phone while you are typing here. In use means
+// the terminal is not known to be unfocused and a key or paste came in the last IDLE.
+
+const IDLE = 3 * 60_000
+const HEARTBEAT = 20_000
+
+export function PushPresence(props: { endpoint: () => Endpoint }) {
+  const renderer = useRenderer()
+  const client = randomUUID()
+  const state = { input: Date.now(), blurred: false, sent: undefined as boolean | undefined, stopped: false }
+
+  const send = (active: boolean) => {
+    if (state.stopped || (state.sent === false && !active)) return
+    state.sent = active
+    const endpoint = props.endpoint()
+    void fetch(new URL("api/ocelot/push/presence", endpoint.url.endsWith("/") ? endpoint.url : endpoint.url + "/"), {
+      method: "POST",
+      headers: { ...Service.headers(endpoint), "content-type": "application/json" },
+      body: JSON.stringify({ client, active }),
+      signal: AbortSignal.timeout(5_000),
+    })
+      .then((response) => {
+        // Not an ocelot server: nothing to report to.
+        if (response.status === 404) state.stopped = true
+      })
+      .catch(() => undefined)
+  }
+  const update = () => send(!state.blurred && Date.now() - state.input < IDLE)
+  const input = () => {
+    const idle = Date.now() - state.input >= IDLE
+    state.input = Date.now()
+    if (idle) update()
+  }
+  const focus = () => {
+    state.blurred = false
+    update()
+  }
+  const blur = () => {
+    state.blurred = true
+    update()
+  }
+
+  useKeyboard(input)
+  usePaste(input)
+  renderer.on("focus", focus)
+  renderer.on("blur", blur)
+  const timer = setInterval(update, HEARTBEAT)
+  update()
+  onCleanup(() => {
+    clearInterval(timer)
+    renderer.off("focus", focus)
+    renderer.off("blur", blur)
+    send(false)
+    state.stopped = true
+  })
+  return null
+}
