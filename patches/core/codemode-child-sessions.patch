diff --git a/packages/core/test/tool-execute.test.ts b/packages/core/test/tool-execute.test.ts
index 59ab70d56..b545acb96 100644
--- a/packages/core/test/tool-execute.test.ts
+++ b/packages/core/test/tool-execute.test.ts
@@ -145,3 +145,54 @@ test("execute supports callable namespace tools", async () => {
   })
   expect(result.content).toEqual([{ type: "text", text: '[\n  "admin",\n  "created"\n]' }])
 })
+
+// ocelot: nested calls report the child sessions they drive on their own row.
+test("execute keeps nested calls' child sessions on their rows", async () => {
+  const input = Schema.Struct({ name: Schema.String })
+  const spawn: Info = {
+    name: "spawn",
+    description: "Start a child session",
+    input,
+    output: Schema.String,
+    options: { namespace: "workers" },
+    execute: ({ name }: { name: string }, context) =>
+      Effect.gen(function* () {
+        yield* context.progress({ sessionID: `ses_${name}`, noise: "x".repeat(10) })
+        return { output: name, metadata: { sessionID: `ses_${name}`, sessionIDs: [`ses_${name}`, "ses_other"] } }
+      }),
+  } as Info
+  const plain: Info = {
+    name: "plain",
+    description: "No sessions",
+    input: Schema.Struct({}),
+    output: Schema.String,
+    options: { namespace: "workers" },
+    execute: (_, context) =>
+      context.progress({ other: 1 }).pipe(Effect.as({ output: "ok", metadata: { other: 1 } })),
+  }
+  const progress: unknown[] = []
+  const result = await Effect.runPromise(
+    createCodeMode(
+      new Map([
+        ["workers_spawn", spawn],
+        ["workers_plain", plain],
+      ]),
+    ).execute(
+      {
+        code: 'return Promise.all([tools.workers.spawn({ name: "a" }), tools.workers.spawn({ name: "b" }), tools.workers.plain({})])',
+      },
+      { ...context, progress: (update) => Effect.sync(() => void progress.push(update)) },
+    ),
+  )
+
+  expect(result.metadata).toEqual({
+    toolCalls: [
+      { tool: "workers.spawn", status: "completed", input: { name: "a" }, sessionIDs: ["ses_a", "ses_other"] },
+      { tool: "workers.spawn", status: "completed", input: { name: "b" }, sessionIDs: ["ses_b", "ses_other"] },
+      { tool: "workers.plain", status: "completed" },
+    ],
+  })
+  // Nested progress still passes through, and the rows follow it with the sessions recorded.
+  expect(progress).toContainEqual({ sessionID: "ses_a", noise: "xxxxxxxxxx" })
+  expect(progress.at(-1)).toEqual({ toolCalls: (result.metadata as { toolCalls: unknown }).toolCalls })
+})
