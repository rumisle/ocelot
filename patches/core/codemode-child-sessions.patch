@@ -142,11 +153,29 @@ export const create = (
 // Rows appear in start order; the same call object arrives at both hooks, so a call finds its row again.
 function progressHooks(record: (update: (items: Array<ExecuteCall>) => Array<ExecuteCall>) => Effect.Effect<unknown>) {
   const rows = new WeakMap<object, number>()
+  // ocelot: the tool receives the same input object the hook saw, which finds the row again.
+  const inputs = new WeakMap<object, object>()
   const start = (call: object, entry: ExecuteCall) =>
     record((items) => {
       rows.set(call, items.length)
       return [...items, entry]
     })
+  const sessions = (input: unknown, metadata: Metadata) => {
+    const call = typeof input === "object" && input !== null ? inputs.get(input) : undefined
+    const index = call === undefined ? undefined : rows.get(call)
+    const found = [
+      ...(typeof metadata.sessionID === "string" ? [metadata.sessionID] : []),
+      ...(Array.isArray(metadata.sessionIDs) ? metadata.sessionIDs.filter((id) => typeof id === "string") : []),
+    ]
+    if (index === undefined || found.length === 0) return Effect.void
+    return record((items) => {
+      const next = [...items]
+      const known = items[index].sessionIDs ?? []
+      const added = found.filter((id) => !known.includes(id))
+      if (added.length > 0) next[index] = { ...items[index], sessionIDs: [...known, ...added] }
+      return next
+    }).pipe(Effect.asVoid)
+  }
   const settle = (call: object, result: CodeMode.CallResult) => {
     const index = rows.get(call)
     if (index === undefined) return Effect.void
@@ -156,8 +185,9 @@ function progressHooks(record: (update: (items: Array<ExecuteCall>) => Array<Exe
       return next
     })
   }
-  return {
+  const hooks = {
     "tool.before": (call) => {
