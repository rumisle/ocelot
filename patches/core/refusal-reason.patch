diff --git a/packages/core/src/session/refusal.ts b/packages/core/src/session/refusal.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b184b1d66da07c0bf0525359f63feeb809b9063d
--- /dev/null
+++ b/packages/core/src/session/refusal.ts
@@ -0,0 +1,26 @@
+export * as SessionRefusal from "./refusal.js"
+
+import type { ProviderMetadata } from "@opencode/ai"
+
+/**
+ * ocelot: the message for a response the provider's safety filter stopped, with advice. The finish
+ * reason carries Anthropic's category and explanation (upstream); other providers may only put them
+ * in provider metadata (stopDetails, refusal).
+ */
+export const message = (
+  event: {
+    readonly reason?: { readonly category?: string; readonly explanation?: string }
+    readonly providerMetadata?: ProviderMetadata
+  },
+  subject = "the response",
+) => {
+  const details = Object.values(event.providerMetadata ?? {})
+    .map((value) => value?.stopDetails ?? value?.refusal)
+    .find((value): value is { category?: unknown; explanation?: unknown } => !!value && typeof value === "object")
+  const text = (value: unknown) => (typeof value === "string" && value.trim() ? value.trim() : undefined)
+  const category = text(event.reason?.category) ?? text(details?.category)
+  const explanation = text(event.reason?.explanation) ?? text(details?.explanation)
+  const head = `The provider's safety filter stopped ${subject}${category ? ` (category: ${category})` : ""}`
+  const why = explanation ? `: ${explanation.replace(/\.?$/, ".")}` : ". It gave no reason."
+  return `${head}${why} Retrying the same conversation is usually stopped again: edit or rephrase your last message, or switch model.`
+}
