diff --git a/packages/core/src/session/refusal.ts b/packages/core/src/session/refusal.ts
new file mode 100644
index 000000000..9be37d8bb
--- /dev/null
+++ b/packages/core/src/session/refusal.ts
@@ -0,0 +1,20 @@
+export * as SessionRefusal from "./refusal.js"
+
+import type { ProviderMetadata } from "@opencode/ai"
+
+/**
+ * ocelot: the message for a response the provider's safety filter stopped. Anthropic says why
+ * in stop_details ({ category, explanation }, both may be null); upstream showed only
+ * "Provider blocked the response".
+ */
+export const message = (metadata: ProviderMetadata | undefined, subject = "the response") => {
+  const details = Object.values(metadata ?? {})
+    .map((value) => value?.stopDetails ?? value?.refusal)
+    .find((value): value is { category?: unknown; explanation?: unknown } => !!value && typeof value === "object")
+  const category = typeof details?.category === "string" && details.category ? details.category : undefined
+  const explanation =
+    typeof details?.explanation === "string" && details.explanation.trim() ? details.explanation.trim() : undefined
+  const head = `The provider's safety filter stopped ${subject}${category ? ` (category: ${category})` : ""}`
+  const why = explanation ? `: ${explanation.replace(/\.?$/, ".")}` : ". It gave no reason."
+  return `${head}${why} Retrying the same conversation is usually stopped again: edit or rephrase your last message, or switch model.`
+}
