     )
   }
 
+  // ocelot: experimental.no_shell_background
+  const withoutBackground = <A, E, R>(body: (registry: Tool.Interface) => Effect.Effect<A, E, R>) =>
+    Effect.acquireUseRelease(
+      Effect.promise(() => tmpdir()),
+      (tmp) => {
+        reset()
+        return Effect.promise(() =>
+          Bun.write(
+            path.join(tmp.path, "opencode.json"),
+            JSON.stringify({ experimental: { no_shell_background: true } }),
+          ),
+        ).pipe(Effect.andThen(withSession(tmp.path, body)))
+      },
+      (tmp) => Effect.promise(() => tmp[Symbol.asyncDispose]().then(() => undefined)),
+    )
+
+  it.live("runs a background request in the foreground when background is off", () =>
+    withoutBackground((registry) =>
+      Effect.gen(function* () {
+        const settled = yield* executeTool(registry, call({ command: "echo still-foreground", background: true }))
+        expect(settled.metadata?.status).toBe("completed")
+        expect(settled.content?.[0]).toMatchObject({ type: "text", text: expect.stringContaining("still-foreground") })
+      }),
+    ),
+  )
+
+  it.live("tells the model the user moved a command to the background when background is off", () =>
+    withoutBackground((registry) =>
+      Effect.gen(function* () {
+        const jobs = yield* Job.Service
+        const scope = yield* Scope.Scope
+        const waiting = yield* executeTool(
+          registry,
+          call({ command: idleCommand, timeout: 50 }, "call-user-background"),
+        ).pipe(Effect.forkIn(scope, { startImmediately: true }))
+        const backgroundWhenReady = (remaining = 1000): Effect.Effect<Job.Info[], Error> =>
+          Effect.gen(function* () {
+            const backgrounded = yield* jobs.backgroundAll({ sessionID })
+            if (backgrounded.length > 0) return backgrounded
+            if (remaining <= 0) return yield* Effect.fail(new Error("Timed out waiting for foreground shell job"))
+            yield* Effect.promise(() => Bun.sleep(1))
+            return yield* backgroundWhenReady(remaining - 1)
+          })
+        yield* backgroundWhenReady()
+        const settled = yield* Fiber.join(waiting)
+        const shellID = typeof settled.metadata?.shellID === "string" ? settled.metadata.shellID : undefined
+        expect(shellID).toStartWith("sh_")
+        if (!shellID) return
+        const shell = yield* Shell.Service
+        const info = yield* shell.get(ID.make(shellID))
+        expect(settled.content).toEqual([
+          {
+            type: "text",
+            text: `The user moved this command to the background (shell ID: ${shellID}).\nOutput is streaming to: ${info.file}`,
+          },
+          {
+            type: "text",
+            text: "The user moved this command to the background so you can keep working. When it finishes, its output arrives as a message. You do not need to wait for it or check on it.",
+          },
+        ])
+        yield* shell.remove(ID.make(shellID))
+      }),
+    ),
+  )
+
   it.live("backgrounds a foreground command when the session is signaled", () =>
