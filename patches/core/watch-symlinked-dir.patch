Date: Thu, 1 Oct 2026 22:06:30 +0800
Subject: core/watcher: watch a symlinked config directory

@parcel/watcher refuses a symlinked directory (inotify: "Not a directory"), so a
~/.config/opencode linked into a dotfiles repo was never watched and config edits
needed a restart. Watch the real directory and report paths under the link.

Ocelot-Patch: core/watch-symlinked-dir

diff --git a/packages/core/src/filesystem/watcher.ts b/packages/core/src/filesystem/watcher.ts
index b5c438661d0b167392370e6a7e597dbc78cffbcf..96c928d286c675b34fa8f8f39f0aa25e92224431 100644
--- a/packages/core/src/filesystem/watcher.ts
+++ b/packages/core/src/filesystem/watcher.ts
@@ -8,7 +8,7 @@ import { makeGlobalNode } from "@opencode/util/effect/app-node"
 import { FSUtil } from "@opencode/util/fs-util"
 import { Cause, Context, Effect, Layer, PubSub, RcMap, Schema, Stream } from "effect"
 import { lazy } from "../util/lazy.js"
-import { watch } from "node:fs"
+import { realpathSync, watch } from "node:fs"
 import path from "path"
 import loadBinding from "./watcher-binding.js"
 
@@ -246,13 +246,19 @@ function subscribeDirectory(
       Effect.as(undefined),
     )
   }
+  // ocelot: Parcel refuses a symlinked directory (inotify: "Not a directory"), e.g. a
+  // ~/.config/opencode linked into a dotfiles repo. Watch the real directory and report
+  // paths under the one the caller asked for.
+  const real = realDirectory(directory)
+  const outside = (file: string) => (real === directory ? file : rebase(file, real, directory))
+  const inside = (file: string) => (real === directory ? file : rebase(file, directory, real))
   const callback: ParcelWatcher.SubscribeCallback = (error, updates) => {
     if (error) Effect.runFork(Effect.logError("watcher callback failed", { error }))
-    for (const update of updates) publish(update)
+    for (const update of updates) publish(real === directory ? update : { ...update, path: outside(update.path) })
   }
   // Copy `ignore`: it aliases the RcMap key, whose structural hash is cached,
   // so the array handed to native code must never be the mutable original.
-  const pending = native.subscribe(directory, callback, { ignore: [...ignore], backend })
+  const pending = native.subscribe(real, callback, { ignore: ignore.map(inside), backend })
   return Effect.promise(() => pending).pipe(
     Effect.map((subscription) => ({ unsubscribe: () => subscription.unsubscribe(), backend })),
     // Interruption (including the timeout below) abandons the pending native
@@ -271,3 +277,18 @@ function subscribeDirectory(
     ),
   )
 }
+
+function realDirectory(directory: string) {
+  try {
+    return realpathSync(directory)
+  } catch {
+    return directory
+  }
+}
+
+/** `file` moved from under `from` to under `to`; paths outside `from` stay as they are. */
+function rebase(file: string, from: string, to: string) {
+  if (file === from) return to
+  if (file.startsWith(from + path.sep)) return to + file.slice(from.length)
+  return file
+}
