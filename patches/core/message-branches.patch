diff --git a/packages/core/src/session/branch.ts b/packages/core/src/session/branch.ts
new file mode 100644
index 000000000..812e83dbb
--- /dev/null
+++ b/packages/core/src/session/branch.ts
@@ -0,0 +1,223 @@
+export * as SessionBranch from "./branch.js"
+
+/**
+ * ocelot: conversation branches. Committing a revert (sending after an edit or undo) used to
+ * delete every message from the boundary on; instead they are parked here as a branch that
+ * hangs off the message just before the boundary (its anchor). Switching to a parked branch
+ * swaps it with the session's current messages after that anchor, so one session holds a tree
+ * of conversations while the model always sees a single linear history. Files are never
+ * touched.
+ *
+ * Parked rows keep their ids and seqs. Every row after an anchor belongs to one branch, so
+ * restoring a branch can never collide with the rows left in the session, and branches that
+ * hang off messages inside a parked branch come back with it (nested edits).
+ *
+ * The table is underscore-prefixed: the migrator leaves such tables to embedders, so it needs
+ * no migration and survives upstream schema changes.
+ */
+
+import { and, asc, eq, gt, lt } from "drizzle-orm"
+import { integer, sqliteTable, text } from "drizzle-orm/sqlite-core"
+import { sql } from "drizzle-orm"
+import { Effect } from "effect"
+import type { Database } from "../database/database.js"
+import type { SessionMessage } from "./message.js"
+import type { SessionSchema } from "./schema.js"
+import { SessionMessageTable } from "./sql.js"
+
+type Db = Database.Interface["db"]
+type Row = typeof SessionMessageTable.$inferSelect
+
+export const BranchTable = sqliteTable("_ocelot_branch", {
+  id: text().primaryKey(),
+  session_id: text().$type<SessionSchema.ID>().notNull(),
+  /** The message the branch hangs off; null when it starts the session. */
+  anchor: text().$type<SessionMessage.ID>(),
+  /** When the branch's first message was created, which orders the alternatives. */
+  time_created: integer().notNull(),
+  rows: text({ mode: "json" }).$type<Row[]>().notNull(),
+})
+
+const ready = new WeakSet<object>()
+const ensure = Effect.fnUntraced(function* (db: Db) {
+  if (ready.has(db)) return
+  yield* db.run(
+    sql`CREATE TABLE IF NOT EXISTS _ocelot_branch (
+      id TEXT PRIMARY KEY,
+      session_id TEXT NOT NULL REFERENCES session_v2(id) ON DELETE CASCADE,
+      anchor TEXT,
+      time_created INTEGER NOT NULL,
+      rows TEXT NOT NULL
+    )`,
+  ).pipe(Effect.orDie)
+  yield* db.run(sql`CREATE INDEX IF NOT EXISTS _ocelot_branch_session_idx ON _ocelot_branch (session_id)`).pipe(Effect.orDie)
+  ready.add(db)
+})
+
+const rowsAfter = (db: Db, sessionID: SessionSchema.ID, seq: number) =>
+  db
+    .select()
+    .from(SessionMessageTable)
+    .where(and(eq(SessionMessageTable.session_id, sessionID), gt(SessionMessageTable.seq, seq)))
+    .orderBy(asc(SessionMessageTable.seq))
+    .all()
+
+const anchorBefore = (db: Db, sessionID: SessionSchema.ID, seq: number) =>
+  db
+    .select({ id: SessionMessageTable.id, seq: SessionMessageTable.seq })
+    .from(SessionMessageTable)
+    .where(and(eq(SessionMessageTable.session_id, sessionID), lt(SessionMessageTable.seq, seq)))
+    .orderBy(sql`${SessionMessageTable.seq} desc`)
+    .limit(1)
+    .get()
+
+const anchorSeq = Effect.fnUntraced(function* (db: Db, sessionID: SessionSchema.ID, anchor: string | null) {
+  if (anchor === null) return -1
+  const row = yield* db
+    .select({ seq: SessionMessageTable.seq })
+    .from(SessionMessageTable)
+    .where(and(eq(SessionMessageTable.session_id, sessionID), eq(SessionMessageTable.id, anchor as SessionMessage.ID)))
+    .get()
+    .pipe(Effect.orDie)
+  return row?.seq
+})
+
+/** Park every message from `boundarySeq` on as branch `id`. Runs inside the revert commit projection. */
+export const park = Effect.fnUntraced(function* (
+  db: Db,
+  input: { id: string; sessionID: SessionSchema.ID; boundarySeq: number },
+) {
+  yield* ensure(db)
+  const rows = yield* rowsAfter(db, input.sessionID, input.boundarySeq - 1).pipe(Effect.orDie)
+  if (rows.length === 0) return
+  const anchor = yield* anchorBefore(db, input.sessionID, input.boundarySeq).pipe(Effect.orDie)
+  yield* db
+    .insert(BranchTable)
+    .values({
+      id: input.id,
+      session_id: input.sessionID,
+      anchor: anchor?.id ?? null,
+      time_created: rows[0]!.time_created,
+      rows,
+    })
+    .onConflictDoNothing()
+    .run()
+    .pipe(Effect.orDie)
+})
+
+/**
+ * Swap branch `branchID` in: park the session's messages after its anchor as `parkID`, then
+ * restore the branch's rows. Returns false when the branch is gone or no longer hangs off a
+ * message of this session.
+ */
+export const swap = Effect.fnUntraced(function* (
+  db: Db,
+  input: { sessionID: SessionSchema.ID; branchID: string; parkID: string },
+) {
+  yield* ensure(db)
+  const branch = yield* db
+    .select()
+    .from(BranchTable)
+    .where(and(eq(BranchTable.id, input.branchID), eq(BranchTable.session_id, input.sessionID)))
+    .get()
+    .pipe(Effect.orDie)
+  if (!branch) return false
+  const seq = yield* anchorSeq(db, input.sessionID, branch.anchor)
+  if (seq === undefined) return false
+  const current = yield* rowsAfter(db, input.sessionID, seq).pipe(Effect.orDie)
+  if (current.length > 0) {
+    yield* db
+      .insert(BranchTable)
+      .values({
+        id: input.parkID,
+        session_id: input.sessionID,
+        anchor: branch.anchor,
+        time_created: current[0]!.time_created,
+        rows: current,
+      })
+      .run()
+      .pipe(Effect.orDie)
+    yield* db
+      .delete(SessionMessageTable)
+      .where(and(eq(SessionMessageTable.session_id, input.sessionID), gt(SessionMessageTable.seq, seq)))
+      .run()
+      .pipe(Effect.orDie)
+  }
+  for (let start = 0; start < branch.rows.length; start += 500)
+    yield* db
+      .insert(SessionMessageTable)
+      .values(branch.rows.slice(start, start + 500).map((row) => ({ ...row, session_id: input.sessionID })))
+      .run()
+      .pipe(Effect.orDie)
+  yield* db.delete(BranchTable).where(eq(BranchTable.id, branch.id)).run().pipe(Effect.orDie)
+  return true
+})
+
+export interface Alternative {
+  /** The parked branch to switch to; null for the session's current messages. */
+  readonly branchID: string | null
+  /** The branch's first prompt. */
+  readonly text: string
+  readonly time: number
+}
+
+export interface Point {
+  /** The first user message after the anchor in the current history, which shows the switcher. */
+  readonly messageID: SessionMessage.ID
+  readonly anchor: SessionMessage.ID | null
+  /** Oldest first; the current branch is the one with branchID null. */
+  readonly alternatives: readonly Alternative[]
+}
+
+const firstPrompt = (rows: readonly Row[]) => {
+  const row = rows.find((item) => item.type === "user")
+  const text = row ? (row.data as { text?: unknown }).text : undefined
+  return { row, text: typeof text === "string" ? text : "" }
+}
+
+/** Branch points visible from the session's current history. */
+export const points = Effect.fnUntraced(function* (db: Db, sessionID: SessionSchema.ID) {
+  yield* ensure(db)
+  const branches = yield* db
+    .select()
+    .from(BranchTable)
+    .where(eq(BranchTable.session_id, sessionID))
+    .orderBy(asc(BranchTable.time_created))
+    .all()
+    .pipe(Effect.orDie)
+  const anchors = new Map<string | null, (typeof branches)[number][]>()
+  for (const branch of branches) {
+    const list = anchors.get(branch.anchor) ?? []
+    list.push(branch)
+    anchors.set(branch.anchor, list)
+  }
+  const result: (Point & { seq: number })[] = []
+  for (const [anchor, parked] of anchors) {
+    const seq = yield* anchorSeq(db, sessionID, anchor)
+    if (seq === undefined) continue
+    const current = yield* db
+      .select()
+      .from(SessionMessageTable)
+      .where(
+        and(
+          eq(SessionMessageTable.session_id, sessionID),
+          gt(SessionMessageTable.seq, seq),
+          eq(SessionMessageTable.type, "user"),
+        ),
+      )
+      .orderBy(asc(SessionMessageTable.seq))
+      .limit(1)
+      .get()
+      .pipe(Effect.orDie)
+    if (!current) continue
+    const alternatives: Alternative[] = parked.map((branch) => ({
+      branchID: branch.id,
+      text: firstPrompt(branch.rows).text,
+      time: branch.time_created,
+    }))
+    alternatives.push({ branchID: null, text: firstPrompt([current]).text, time: current.time_created })
+    alternatives.sort((a, b) => a.time - b.time)
+    result.push({ messageID: current.id, anchor: anchor as SessionMessage.ID | null, alternatives, seq })
+  }
+  return result.sort((a, b) => a.seq - b.seq).map(({ seq: _, ...point }): Point => point)
+})
