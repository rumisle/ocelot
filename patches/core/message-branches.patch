+// ocelot: committing a revert parks the reverted messages as a branch instead of deleting them.
+describe("Session branches", () => {
+  it.live(
+    "edit keeps the old messages as a branch; switching swaps them, nested branches follow",
+    () =>
+      Effect.gen(function* () {
+        const tmp = yield* tmpdirScoped()
+        const session = yield* Session.Service
+        const database = yield* Database.Service
+        const bus = yield* Bus.Service
+        const created = yield* session.create({ location: { directory: AbsolutePath.make(tmp.path) } })
+        const sessionID = created.id
+
+        yield* Effect.gen(function* () {
+          const plugins = yield* Plugin.Service
+          yield* plugins.awaitActivation
+          const turn = Effect.fnUntraced(function* (text: string) {
+            const prompt = yield* session.prompt({ sessionID, text, resume: false })
+            yield* SessionInbox.promote(database.db, bus, sessionID, "steer")
+            const assistantMessageID = SessionMessage.ID.create()
+            yield* bus.publish(SessionEvent.Step.Started, {
+              sessionID,
+              assistantMessageID,
+              agent: Agent.defaultID,
+              model: { id: Model.ID.make("test-model"), providerID: Provider.ID.make("test-provider") },
+              started: 0,
+            })
+            yield* bus.publish(SessionEvent.Step.Ended, {
+              sessionID,
+              assistantMessageID,
+              finish: "stop",
+              cost: Money.USD.zero,
+              tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+            })
+            return { user: prompt.id, assistant: assistantMessageID }
+          })
+          const prompts = Effect.fnUntraced(function* () {
+            const messages = yield* session.context(sessionID)
+            return messages.flatMap((message) => (message.type === "user" ? [message.text] : []))
+          })
+          const edit = Effect.fnUntraced(function* (messageID: SessionMessage.ID, text: string) {
+            yield* session.revert.stage({ sessionID, messageID })
+            return yield* turn(text)
+          })
+          const shape = Effect.fnUntraced(function* () {
+            return (yield* session.branch.list(sessionID)).map((point) =>
+              point.alternatives.map((item) => (item.branchID === null ? `*${item.text}` : item.text)),
+            )
+          })
+          const switchTo = Effect.fnUntraced(function* (text: string) {
+            const points = yield* session.branch.list(sessionID)
+            const target = points.flatMap((point) => point.alternatives).find((item) => item.text === text)
+            if (!target?.branchID) throw new Error(`no parked branch ${text}`)
+            expect((yield* session.branch.switch({ sessionID, branchID: target.branchID })).switched).toBe(true)
+          })
+
+          const one = yield* turn("one")
+          const two = yield* turn("two")
+          yield* turn("three")
+          expect(yield* shape()).toEqual([])
+
+          // Edit "two": "two" and "three" are parked, not deleted.
+          const twoB = yield* edit(two.user, "two B")
+          expect(yield* prompts()).toEqual(["one", "two B"])
+          const points = yield* session.branch.list(sessionID)
+          expect(points.map((point) => [point.messageID, point.anchor])).toEqual([[twoB.user, one.assistant]])
+          expect(yield* shape()).toEqual([["two", "*two B"]])
+
+          // Switch back: the old messages return with their ids; the edit is parked.
+          yield* switchTo("two")
+          expect(yield* prompts()).toEqual(["one", "two", "three"])
+          expect((yield* session.context(sessionID)).some((message) => message.id === two.user)).toBe(true)
+          expect(yield* shape()).toEqual([["*two", "two B"]])
+
+          // A nested edit inside the old branch, then away and back: the nested point follows.
+          const three = (yield* session.context(sessionID)).findLast((message) => message.type === "user")!
+          yield* edit(three.id, "three B")
+          expect(yield* shape()).toEqual([["*two", "two B"], ["three", "*three B"]])
+          yield* switchTo("two B")
+          expect(yield* prompts()).toEqual(["one", "two B"])
+          expect(yield* shape()).toEqual([["two", "*two B"]])
+          yield* switchTo("two")
+          expect(yield* prompts()).toEqual(["one", "two", "three B"])
+          expect(yield* shape()).toEqual([["*two", "two B"], ["three", "*three B"]])
+
+          // The next turn continues the restored history.
+          yield* turn("four")
+          expect(yield* prompts()).toEqual(["one", "two", "three B", "four"])
+
+          // A stale or foreign branch id is refused.
+          expect((yield* session.branch.switch({ sessionID, branchID: "brn_missing" })).switched).toBe(false)
+
+          // Deleting the session deletes its branches.
+          yield* session.remove(sessionID)
+          const left = yield* database.db.all<{ n: number }>(
+            sql`SELECT count(*) AS n FROM _ocelot_branch WHERE session_id = ${sessionID}`,
+          )
+          expect(left[0]?.n).toBe(0)
+        }).pipe(Effect.provide(LocationServiceMap.Service.get(created.location)))
+      }),
+    { timeout: 15_000 },
+  )
+})
