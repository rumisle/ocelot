+    script = [good]
+
+    expect(yield* compactManually(session, messages)).toEqual({ status: "completed" })
+    const checkpoint = yield* stored(session.id)
+    expect(checkpoint?.recent).toBe("")
+    expect(checkpoint?.keep).toEqual({ id: messages[2]!.id, seq: 3 })
+    const history = yield* context(session.id)
+    expect(history.map(describe)).toEqual([
+      "compaction",
+      "Second request: now test the thing",
+      JSON.stringify(messages[3]!.type === "assistant" ? messages[3].content : []),
+    ])
+    // The model sees the checkpoint, then the kept messages themselves.
+    const sent = toLLMMessages(history, { id: "checkpoint-model", providerID: "test" } as never)
+    expect(JSON.stringify(sent[0])).toContain("continue the conversation verbatim")
+    expect(JSON.stringify(sent[0])).not.toContain("recent-context")
+    expect(JSON.stringify(sent[0])).toContain("## Goal")
+    expect(sent.map((message) => message.role)).toEqual(["user", "user", "assistant"])
+  }),
+)
+
+it.effect("kept messages do not make the next step compact again with their old usage", () =>
+  Effect.gen(function* () {
+    yield* configure({ keep: 10 })
+    const compaction = yield* SessionCompaction.Service
+    const session = yield* insertSession(Session.ID.make("ses_checkpoint_stale_usage"))
+    // The kept reply measured a nearly full window before the compaction.
+    const messages = [...conversation().slice(0, 3), assistant("Tests are running.", 190_000)]
+    yield* seed(session.id, messages)
+    script = [good]
+    expect(yield* compactManually(session, messages)).toEqual({ status: "completed" })
+
+    requests = []
+    const after = loaded(session, yield* context(session.id))
+    expect(SessionCompaction.estimateContext(after)).toBeLessThan(10_000)
+    expect(yield* compaction.compact({ reason: "auto", context: after })).toEqual({ status: "skipped" })
+    expect(requests).toHaveLength(0)
+  }),
+)
+
+it.effect("kept history leaves out earlier checkpoints and superseded instruction updates", () =>
+  Effect.gen(function* () {
+    yield* configure({ keep: 50 })
+    const session = yield* insertSession(Session.ID.make("ses_checkpoint_supersede"))
+    const [first, reply, second, done] = conversation()
+    const big = assistant(`Long step: ${"output ".repeat(600)}`)
+    const earlier = Schema.decodeUnknownSync(SessionMessage.CompactionCompleted)({
+      id: SessionMessage.ID.create(),
+      type: "compaction",
+      status: "completed",
+      reason: "auto",
+      summary: "## Goal\n- earlier",
+      recent: "",
+      keep: { id: second!.id, seq: 3 },
+      time: { created: 0 },
+    })
+    const instructions = SessionMessage.System.make({
+      id: SessionMessage.ID.create(),
