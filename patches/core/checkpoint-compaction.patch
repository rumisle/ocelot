+    expect(yield* compactManually(session, live)).toEqual({ status: "completed" })
+    expect((yield* stored(session.id))?.keep).toEqual({ id: big.id, seq: 4 })
+    expect((yield* context(session.id)).map(describe)).toEqual(["compaction", describe(big), describe(done!)])
+  }),
+)
+
+it.effect("a kept boundary survives renumbering by id and id rewrites by sequence", () =>
+  Effect.gen(function* () {
+    yield* configure({ keep: 10 })
+    const db = (yield* Database.Service).db
+    const session = yield* insertSession(Session.ID.make("ses_checkpoint_boundary"))
+    const messages = conversation()
+    yield* seed(session.id, messages)
+    script = [good]
+    expect(yield* compactManually(session, messages)).toEqual({ status: "completed" })
+    const expected = (yield* context(session.id)).map(describe)
+    const row = yield* db
+      .select()
+      .from(SessionMessageTable)
+      .where(eq(SessionMessageTable.type, "compaction"))
+      .all()
+      .pipe(Effect.orDie)
+    const compaction = row.find((item) => item.session_id === session.id)!
+    const rewrite = (keep: unknown) =>
+      db
+        .update(SessionMessageTable)
+        .set({ data: { ...compaction.data, keep } as typeof compaction.data })
+        .where(eq(SessionMessageTable.id, compaction.id))
+        .run()
+        .pipe(Effect.orDie)
+
+    // A fork rewrote the kept message's id; its sequence still finds it.
+    yield* rewrite({ id: "msg_rewritten_by_fork", seq: 3 })
+    expect((yield* context(session.id)).map(describe)).toEqual(expected)
+    // An import renumbered sequences; the id still finds it.
+    yield* rewrite({ id: messages[2]!.id, seq: 99 })
+    expect((yield* context(session.id)).map(describe)).toEqual(expected)
+  }),
+)
+
+it.effect("a single long run is cut between its steps, not kept whole", () =>
+  Effect.gen(function* () {
+    yield* configure({ keep: 1_000 })
+    const session = yield* insertSession(Session.ID.make("ses_checkpoint_long_run"))
+    const step = (index: number) => assistant(`Step ${index}: ${"output ".repeat(600)}`)
+    const messages = [user("Earlier request"), assistant("Done."), user("Run the long job"), ...[1, 2, 3, 4, 5, 6].map(step)]
+    yield* seed(session.id, messages)
+    script = [good]
+    requests = []
+
+    expect(yield* compactManually(session, messages)).toEqual({ status: "completed" })
+    const history = (yield* context(session.id)).map(describe)
+    expect(history[0]).toBe("compaction")
+    expect(history.length).toBeLessThan(messages.length)
+    expect(history.slice(1).every((item) => item.includes("Step "))).toBe(true)
+    expect(last(requests[0])).toContain("from your reply starting")
+  }),
+)
