+import { SessionStore } from "@opencode/core/session/store"
+import { Session } from "@opencode/core/session"
+import { Project } from "@opencode/core/project"
+import { ProjectTable } from "@opencode/core/project/sql"
+import { Agent } from "@opencode/core/agent"
+import { AbsolutePath } from "@opencode/core/schema"
+import { DateTime, Effect, Fiber, Layer, Schema, Stream } from "effect"
+import { eq } from "drizzle-orm"
+import { TestClock } from "effect/testing"
+import { testEffect } from "./lib/effect"
+
+// ocelot: the checkpoint strategy (patch core/checkpoint-compaction).
+
+type Reply = (request: LLMRequest) => Stream.Stream<LLMEvent>
+let requests: LLMRequest[] = []
+let script: Reply[] = []
+
+const usage = {
+  inputTokens: 15,
+  outputTokens: 6,
+  nonCachedInputTokens: 10,
+  cacheReadInputTokens: 3,
+  cacheWriteInputTokens: 2,
+}
+const text = (value: string): Reply => () =>
+  Stream.make(
+    LLMEvent.textDelta({ id: "reply", text: value }),
+    LLMEvent.stepFinish({ index: 0, reason: { normalized: "stop" }, usage }),
+    LLMEvent.finish({ reason: { normalized: "stop" } }),
+  )
+const CHECKPOINT = [
+  "## Goal",
+  "- Ship the checkpoint strategy.",
+  "## Constraints & Preferences",
+  "- (none)",
+  "## Progress",
+  "### Done",
+  "- [x] Wrote the prompt",
+  "## Running",
+  "- (none)",
+  "## Key Decisions",
+  "- **Follow-up**: keeps the cache",
+  "## Next Steps",
+  "1. Test it",
+  "## Relevant Files",
+  "- `packages/core/src/session/compaction.ts`: the strategy",
+].join("\n")
+const good = text(CHECKPOINT)
+const toolCall: Reply = () =>
+  Stream.make(
+    LLMEvent.toolCall({ id: "call_1", name: "read", input: { path: "x" } }),
+    LLMEvent.stepFinish({ index: 0, reason: { normalized: "tool-calls" }, usage }),
+    LLMEvent.finish({ reason: { normalized: "tool-calls" } }),
+  )
+const stall: Reply = () => Stream.never
+
+const client = Layer.mock(LLMClient.Service)({
+  stream: (request: LLMRequest) => {
+    requests.push(request)
+    return (script.shift() ?? good)(request)
+  },
+  generate: () => Effect.die("unused"),
+})
+const model = LanguageModel.make({ id: "checkpoint-model", provider: "test", route: OpenAIChat.route })
+const resolve = (limit: { context: number; input?: number; output: number }) =>
+  SessionRunnerModel.resolved(model, {
+    capabilities: { tools: true, input: ["text"], output: ["text"] },
+    cost: [],
+    limit,
+  })
+const it = testEffect(
+  AppNodeBuilder.build(
+    LayerNode.group([
+      Database.node,
+      Bus.node,
+      SessionProjector.node,
+      SessionStore.node,
+      SessionCompaction.node,
+      SessionModelRequest.node,
+      PluginHooks.node,
+    ]),
+    [Bus.node.replace(Bus.configured({ persist: true })), llmClient.replace(client)],
+  ),
+)
+
+const configure = (settings: Partial<SessionCompaction.Settings>) =>
+  Effect.gen(function* () {
+    const compaction = yield* SessionCompaction.Service
+    yield* compaction.transform((editor) => editor.configure({ strategy: "checkpoint", ...settings }))
+  })
+
+const insertSession = (id: Session.ID, overrides?: Partial<typeof SessionTable.$inferInsert>) =>
+  Effect.gen(function* () {
+    const db = (yield* Database.Service).db
+    yield* db
+      .insert(ProjectTable)
+      .values({ id: Project.ID.global, worktree: AbsolutePath.make("/project"), sandboxes: [] })
+      .onConflictDoNothing()
+      .run()
+      .pipe(Effect.orDie)
+    yield* db
+      .insert(SessionTable)
+      .values({ id, project_id: Project.ID.global, slug: id, directory: "/project", title: id, version: "test", ...overrides })
+      .run()
+      .pipe(Effect.orDie)
+    const store = yield* SessionStore.Service
+    return yield* store
+      .get(id)
+      .pipe(Effect.flatMap((session) => (session ? Effect.succeed(session) : Effect.die(`session missing: ${id}`))))
+  })
+
+const user = (value: string) =>
+  SessionMessage.User.make({ id: SessionMessage.ID.create(), type: "user", text: value, time: { created: DateTime.makeUnsafe(0) } })
+const assistant = (value: string, input = 0) =>
+  Schema.decodeUnknownSync(SessionMessage.Assistant)({
+    id: SessionMessage.ID.create(),
+    type: "assistant",
+    agent: Agent.defaultID,
+    model: { id: "checkpoint-model", providerID: "test" },
+    content: [{ type: "text", text: value }],
+    tokens: { input, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+    time: { created: 0, completed: 0 },
+  })
+const conversation = () => [
+  user("First request: build the thing"),
+  assistant("Built the first part."),
+  user("Second request: now test the thing"),
+  assistant("Tests are running."),
+]
+
+const loaded = (
+  session: Session.Info,
+  messages: readonly SessionMessage.Info[],
+  limit = { context: 200_000, output: 32_000 },
+): SessionContext.Loaded => ({
+  session,
+  messages,
+  model: resolve(limit),
+  agent: { id: Agent.defaultID, info: Agent.Info.default(Agent.defaultID) },
+  initial: "Session instructions",
+  tools: { definitions: [], execute: () => Effect.die("Compaction must not execute tools") },
+})
+
+const compactManually = (session: Session.Info, messages: readonly SessionMessage.Info[]) =>
+  Effect.gen(function* () {
+    const bus = yield* Bus.Service
+    const compaction = yield* SessionCompaction.Service
+    const inputID = SessionMessage.ID.create()
+    yield* bus.publish(SessionEvent.Compaction.Started, { sessionID: session.id, reason: "manual", recent: "", inputID })
+    return yield* compaction.compact({ reason: "manual", context: loaded(session, messages), inputID })
+  })
+
+const stored = (id: Session.ID) =>
+  Effect.gen(function* () {
+    const store = yield* SessionStore.Service
+    const first = (yield* store.context(id))[0]
+    return first?.type === "compaction" && first.status === "completed" ? first : undefined
+  })
+
+const last = (request: LLMRequest | undefined) => JSON.stringify(request?.messages.at(-1))
+
+const encodeMessage = Schema.encodeSync(SessionMessage.Info)
+/** Stores messages as a session's history (sequences 1…n), as the projector would have. */
+const seed = (sessionID: Session.ID, messages: readonly SessionMessage.Info[]) =>
+  Effect.gen(function* () {
+    const db = (yield* Database.Service).db
+    yield* db
+      .insert(SessionMessageTable)
+      .values(
+        messages.map((message, index) => {
+          const encoded = encodeMessage(message)
+          const { id, type, ...data } = encoded
+          return {
+            id: SessionMessage.ID.make(id),
+            session_id: sessionID,
+            type,
+            seq: index + 1,
+            time_created: encoded.time.created,
+            data,
+          }
+        }),
+      )
+      .run()
+      .pipe(Effect.orDie)
+    yield* Bus.reserveSequence(db, sessionID, messages.length)
+  })
+const context = (id: Session.ID) =>
+  Effect.gen(function* () {
+    const store = yield* SessionStore.Service
+    return yield* store.context(id)
+  })
+const describe = (message: SessionMessage.Info) =>
+  message.type === "user" ? message.text : message.type === "assistant" ? JSON.stringify(message.content) : message.type
+
+it.effect("checkpoint compacts at 90% of the window, capped at 540k tokens", () =>
+  Effect.gen(function* () {
+    yield* configure({})
+    const compaction = yield* SessionCompaction.Service
+    const session = yield* insertSession(Session.ID.make("ses_checkpoint_threshold"))
+    const due = (tokens: number, limit: { context: number; input?: number; output: number }) =>
+      compaction
+        .compact({ reason: "auto", context: loaded(session, [assistant("Done", tokens)], limit) })
+        .pipe(Effect.map((outcome) => outcome.status !== "skipped"))
+    script = []
+    requests = []
+
+    expect(yield* due(179_999, { context: 200_000, output: 32_000 })).toBe(false)
+    expect(yield* due(599_999, { context: 1_000_000, output: 32_000 })).toBe(true)
+    requests = []
+    expect(yield* due(539_999, { context: 1_000_000, output: 32_000 })).toBe(false)
+    expect(requests).toHaveLength(0)
+
+    yield* configure({ ratio: 0.5, max: 100_000 })
+    expect(yield* due(99_999, { context: 1_000_000, output: 32_000 })).toBe(false)
+    expect(yield* due(79_999, { context: 160_000, output: 32_000 })).toBe(false)
+    expect(yield* due(80_000, { context: 160_000, output: 32_000 })).toBe(true)
+  }),
+)
+
+it.effect("checkpoint sends the whole live context with the checkpoint prompt appended", () =>
+  Effect.gen(function* () {
+    yield* configure({ keep: 10 })
+    const session = yield* insertSession(Session.ID.make("ses_checkpoint_follow_up"))
+    script = [good]
+    requests = []
+    const hooks = yield* PluginHooks.Service
+    let hooked = 0
+    yield* hooks.register("session", "compaction", (event) => Effect.sync(() => (hooked = event.messages.length)))
+
+    expect(yield* compactManually(session, conversation())).toEqual({ status: "completed" })
+
+    expect(requests).toHaveLength(1)
+    const sent = JSON.stringify(requests[0]?.messages)
+    // Unlike the summary strategy, the recent exchange is part of the request too: it is the cached prefix.
+    expect(sent).toContain("First request: build the thing")
+    expect(sent).toContain("Tests are running.")
+    expect(requests[0]?.messages).toHaveLength(hooked + 1)
+    expect(last(requests[0])).toContain("This is not a new task")
+    expect(last(requests[0])).toContain('from the user message starting \\"Second request: now test the thing\\"')
+    const checkpoint = yield* stored(session.id)
+    expect(checkpoint?.summary).toBe(CHECKPOINT)
+    // These messages were never stored, so the kept part falls back to upstream's text.
+    expect(checkpoint?.keep).toBeUndefined()
+    expect(checkpoint?.recent).toContain("[User]: Second request: now test the thing")
+  }),
+)
+
+it.effect("checkpoint reminds a reply that calls a tool, then accepts the checkpoint", () =>
+  Effect.gen(function* () {
+    yield* configure({})
+    const session = yield* insertSession(Session.ID.make("ses_checkpoint_tool_call"))
+    script = [toolCall, good]
+    requests = []
+
+    expect(yield* compactManually(session, conversation())).toEqual({ status: "completed" })
+    expect(requests).toHaveLength(2)
+    expect(last(requests[1])).toContain("That was not the checkpoint")
+    expect((yield* stored(session.id))?.summary).toBe(CHECKPOINT)
+  }),
+)
+
+it.effect("checkpoint falls back to a summary after two unusable replies", () =>
+  Effect.gen(function* () {
+    yield* configure({})
+    const session = yield* insertSession(Session.ID.make("ses_checkpoint_fallback"))
+    const summary = "## Objective\n- fallback summary"
+    script = [toolCall, text("Sure, continuing the work now."), text(summary)]
+    requests = []
+
+    expect(yield* compactManually(session, conversation())).toEqual({ status: "completed" })
+    expect(requests).toHaveLength(3)
+    expect(last(requests[2])).toContain("Summarize only what")
+    expect((yield* stored(session.id))?.summary).toBe(summary)
+  }),
+)
+
+it.effect("checkpoint retries a response that stalls past the timeout", () =>
+  Effect.gen(function* () {
+    yield* configure({ timeout: 1_000 })
+    const session = yield* insertSession(Session.ID.make("ses_checkpoint_stall"))
+    script = [stall, good]
+    requests = []
+
+    const fiber = yield* compactManually(session, conversation()).pipe(Effect.forkScoped)
+    for (let step = 0; step < 20 && requests.length < 2; step++) yield* TestClock.adjust("1 second")
+    expect(yield* Fiber.join(fiber)).toEqual({ status: "completed" })
+    expect(requests).toHaveLength(2)
+    expect((yield* stored(session.id))?.summary).toBe(CHECKPOINT)
+  }),
+)
+
+it.effect("overflow recovery keeps the summary path: the live context no longer fits", () =>
+  Effect.gen(function* () {
+    yield* configure({})
+    const compaction = yield* SessionCompaction.Service
+    const session = yield* insertSession(Session.ID.make("ses_checkpoint_overflow"))
+    script = [text("## Objective\n- overflow summary")]
+    requests = []
+
+    const outcome = yield* compaction.compact({ reason: "overflow", context: loaded(session, conversation()) })
+    expect(outcome).toEqual({ status: "completed" })
+    expect(last(requests[0])).toContain("Summarize only what")
+    expect(last(requests[0])).not.toContain("This is not a new task")
+  }),
+)
+
+it.effect("the summary strategy stays the default", () =>
+  Effect.gen(function* () {
+    yield* configure({ strategy: "summary" })
+    const session = yield* insertSession(Session.ID.make("ses_checkpoint_default"))
+    script = [text("## Objective\n- summary")]
+    requests = []
+
+    expect(yield* compactManually(session, conversation())).toEqual({ status: "completed" })
+    expect(last(requests[0])).toContain("Summarize only what")
+  }),
+)
+
+it.effect("checkpoint keeps the newest messages as messages, with the checkpoint in front", () =>
+  Effect.gen(function* () {
+    yield* configure({ keep: 10 })
+    const session = yield* insertSession(Session.ID.make("ses_checkpoint_keep"))
+    const messages = conversation()
