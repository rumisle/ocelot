@@ -0,0 +1,468 @@
+import { expect } from "bun:test"
+import { LLMClient, LLMEvent, LanguageModel, type LLMRequest } from "@opencode/ai"
+import { OpenAIChat } from "@opencode/ai/protocols"
+import { Database } from "@opencode/core/database/database"
