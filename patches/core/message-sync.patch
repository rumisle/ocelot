diff --git a/packages/core/test/session-message-sync.test.ts b/packages/core/test/session-message-sync.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d955029ef619560fa8f65e2f6990ff344b546a96
--- /dev/null
+++ b/packages/core/test/session-message-sync.test.ts
@@ -0,0 +1,258 @@
+import { afterEach, describe, expect, test } from "bun:test"
+import { eq } from "drizzle-orm"
+import { Effect } from "effect"
+import { Agent } from "@opencode/core/agent"
+import { Bus } from "@opencode/core/bus"
+import { Database } from "@opencode/core/database/database"
+import { AppNodeBuilder } from "@opencode/core/effect/app-node-builder"
+import { ID } from "@opencode/core/model"
+import { ProjectTable } from "@opencode/core/project/sql"
+import { Provider } from "@opencode/core/provider"
+import { LiveContent } from "@opencode/core/session/live-content"
+import { SessionProjector } from "@opencode/core/session/projector"
+import { SessionMessageTable } from "@opencode/core/session/sql"
+import { SessionStore } from "@opencode/core/session/store"
+import { Project } from "@opencode/schema/project"
+import { AbsolutePath } from "@opencode/schema/schema"
+import { Session } from "@opencode/schema/session"
+import { SessionEvent } from "@opencode/schema/session-event"
+import { SessionMessage } from "@opencode/schema/session-message"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { testEffect } from "./lib/effect"
+
+const it = testEffect(
+  AppNodeBuilder.build(LayerNode.group([Database.node, Bus.node, SessionProjector.node, SessionStore.node]), [
+    Bus.node.replace(Bus.configured({ persist: true })),
+  ]),
+)
+
+const sessionID = Session.ID.make("ses_sync")
+
+// A session with `count` synthetic messages; returns their ids oldest first.
+const seed = (count: number) =>
+  Effect.gen(function* () {
+    const database = yield* Database.Service
+    const bus = yield* Bus.Service
+    const directory = AbsolutePath.make("/project")
+    yield* database.db.insert(ProjectTable).values({ id: Project.ID.global, worktree: directory, sandboxes: [] }).run()
+    yield* bus.publish(SessionEvent.Created, {
+      sessionID,
+      projectID: Project.ID.global,
+      location: { directory },
+      slug: "sync-test",
+      version: "test",
+    })
+    for (let index = 0; index < count; index++)
+      yield* bus.publish(SessionEvent.Synthetic, { sessionID, text: `message ${index}` })
+    const rows = yield* database.db
+      .select({ id: SessionMessageTable.id })
+      .from(SessionMessageTable)
+      .where(eq(SessionMessageTable.session_id, sessionID))
+      .orderBy(SessionMessageTable.seq)
+      .all()
+    // Pretend everything was written long ago.
+    yield* database.db.update(SessionMessageTable).set({ time_updated: 1_000 }).run()
+    return { bus, database, ids: rows.map((row) => row.id) }
+  })
+
+describe("SessionStore.messageSync", () => {
+  afterEach(() => LiveContent.reset())
+
+  it.effect("returns the newest messages with their update times", () =>
+    Effect.gen(function* () {
+      const { ids } = yield* seed(6)
+      const store = yield* SessionStore.Service
+      const result = yield* store.messageSync({ sessionID, limit: 4 })
+      expect(result.reset).toBe(false)
+      expect(result.ids).toEqual(ids.slice(2))
+      expect(result.updated).toEqual([1_000, 1_000, 1_000, 1_000])
+      expect(result.data.map((message) => message.id)).toEqual(ids.slice(2))
+      expect(result.watermark).toBeGreaterThan(Date.now() - 5_000)
+      // More than the session holds is everything.
+      expect((yield* store.messageSync({ sessionID, limit: 100 })).ids).toEqual(ids)
+    }),
+  )
+
+  it.effect("lists everything from `from` but sends data only for what changed since `since`", () =>
+    Effect.gen(function* () {
+      const { ids, database } = yield* seed(8)
+      const store = yield* SessionStore.Service
+      const now = Date.now()
+      yield* database.db
+        .update(SessionMessageTable)
+        .set({ time_updated: now })
+        .where(eq(SessionMessageTable.id, SessionMessage.ID.make(ids[5]!)))
+        .run()
+      const result = yield* store.messageSync({ sessionID, from: SessionMessage.ID.make(ids[2]!), since: now - 1 })
+      expect(result.ids).toEqual(ids.slice(2))
+      expect(result.updated[3]).toBe(now)
+      expect(result.data.map((message) => message.id)).toEqual([ids[5]])
+      // The margin: a change from a few seconds before `since` is sent again; older ones are not.
+      yield* database.db
+        .update(SessionMessageTable)
+        .set({ time_updated: now - 5_000 })
+        .where(eq(SessionMessageTable.id, SessionMessage.ID.make(ids[6]!)))
+        .run()
+      yield* database.db
+        .update(SessionMessageTable)
+        .set({ time_updated: now - 60_000 })
+        .where(eq(SessionMessageTable.id, SessionMessage.ID.make(ids[7]!)))
+        .run()
+      const margin = yield* store.messageSync({ sessionID, from: SessionMessage.ID.make(ids[2]!), since: now })
+      expect(margin.data.map((message) => message.id)).toEqual([ids[5], ids[6]])
+    }),
+  )
+
+  it.effect("sends the requested stale messages as well", () =>
+    Effect.gen(function* () {
+      const { ids } = yield* seed(5)
+      const store = yield* SessionStore.Service
+      const result = yield* store.messageSync({
+        sessionID,
+        from: SessionMessage.ID.make(ids[0]!),
+        since: Date.now(),
+        include: [SessionMessage.ID.make(ids[1]!), SessionMessage.ID.make(ids[3]!), SessionMessage.ID.make("msg_gone")],
+      })
+      expect(result.ids).toEqual(ids)
+      expect(result.data.map((message) => message.id)).toEqual([ids[1], ids[3]])
+    }),
+  )
+
+  it.effect("sends everything older than the oldest message the caller holds", () =>
+    Effect.gen(function* () {
+      const { ids } = yield* seed(8)
+      const store = yield* SessionStore.Service
+      const result = yield* store.messageSync({
+        sessionID,
+        from: SessionMessage.ID.make(ids[1]!),
+        since: Date.now(),
+        held: SessionMessage.ID.make(ids[5]!),
+      })
+      expect(result.ids).toEqual(ids.slice(1))
+      expect(result.data.map((message) => message.id)).toEqual(ids.slice(1, 5))
+      // A held message that is gone sends the whole range.
+      const gone = yield* store.messageSync({
+        sessionID,
+        from: SessionMessage.ID.make(ids[6]!),
+        since: Date.now(),
+        held: SessionMessage.ID.make("msg_gone"),
+      })
+      expect(gone.data.map((message) => message.id)).toEqual(ids.slice(6))
+    }),
+  )
+
+  it.effect("sends everything when `since` is ahead of the server clock", () =>
+    Effect.gen(function* () {
+      const { ids } = yield* seed(3)
+      const store = yield* SessionStore.Service
+      const result = yield* store.messageSync({
+        sessionID,
+        from: SessionMessage.ID.make(ids[0]!),
+        since: Date.now() + 3_600_000,
+      })
+      expect(result.data.map((message) => message.id)).toEqual(ids)
+    }),
+  )
+
+  it.effect("resets when `from` is gone or belongs to another session", () =>
+    Effect.gen(function* () {
+      yield* seed(3)
+      const store = yield* SessionStore.Service
+      const missing = yield* store.messageSync({ sessionID, from: SessionMessage.ID.make("msg_missing"), since: 0 })
+      expect(missing).toMatchObject({ ids: [], data: [], reset: true })
+      const other = yield* store.messageSync({
+        sessionID: Session.ID.make("ses_other"),
+        from: SessionMessage.ID.make("msg_missing"),
+      })
+      expect(other.reset).toBe(true)
+    }),
+  )
+
+  it.effect("always sends an unfinished step, with what has been streamed into it", () =>
+    Effect.gen(function* () {
+      const { bus, ids } = yield* seed(2)
+      const store = yield* SessionStore.Service
+      const assistantMessageID = SessionMessage.ID.create()
+      yield* bus.publish(SessionEvent.Step.Started, {
+        sessionID,
+        assistantMessageID,
+        agent: Agent.ID.make("build"),
+        model: { id: ID.make("model"), providerID: Provider.ID.make("test") },
+        started: 0,
+      })
+      yield* bus.publish(SessionEvent.Text.Started, { sessionID, assistantMessageID, ordinal: 0 })
+      const database = yield* Database.Service
+      yield* database.db.update(SessionMessageTable).set({ time_updated: 1_000 }).run()
+      expect(LiveContent.append(assistantMessageID, "text", 0, "Hello")).toBe(0)
+      expect(LiveContent.append(assistantMessageID, "text", 0, ", world")).toBe(5)
+
+      const synced = yield* store.messageSync({ sessionID, from: SessionMessage.ID.make(ids[0]!), since: Date.now() })
+      expect(synced.data.map((message) => message.id)).toEqual([assistantMessageID])
+      // The store reads what is stored; the Session service adds the overlay (checked below).
+      const stored = synced.data[0]!
+      expect(stored.type === "assistant" && stored.content).toEqual([{ type: "text", text: "" }])
+      const overlaid = LiveContent.overlay(stored)
+      expect(overlaid.type === "assistant" && overlaid.content).toEqual([{ type: "text", text: "Hello, world" }])
+
+      // Once the block ends, the stored text is used and the overlay is gone.
+      yield* bus.publish(SessionEvent.Text.Ended, { sessionID, assistantMessageID, ordinal: 0, text: "Hello, world!" })
+      expect(LiveContent.has(assistantMessageID)).toBe(false)
+      const ended = yield* store.messageSync({ sessionID, limit: 1 })
+      const message = ended.data[0]!
+      expect(message.type === "assistant" && message.content).toEqual([{ type: "text", text: "Hello, world!" }])
+    }),
+  )
+})
+
+describe("LiveContent", () => {
+  afterEach(() => LiveContent.reset())
+
+  const assistant = (content: SessionMessage.Assistant["content"]) =>
+    ({
+      id: SessionMessage.ID.make("msg_live"),
+      type: "assistant",
+      agent: Agent.ID.make("build"),
+      model: { id: ID.make("model"), providerID: Provider.ID.make("test") },
+      content,
+      time: { created: new Date(0) },
+    }) as unknown as SessionMessage.Assistant
+
+  test("fills the open block by ordinal and leaves completed blocks alone", () => {
+    LiveContent.append("msg_live", "text", 1, "second ")
+    LiveContent.append("msg_live", "text", 1, "block")
+    LiveContent.append("msg_live", "reasoning", 0, "thinking")
+    const message = assistant([
+      { type: "reasoning", text: "" },
+      { type: "text", text: "first block" },
+      { type: "text", text: "" },
+    ] as never)
+    const result = LiveContent.overlay(message) as SessionMessage.Assistant
+    expect(result.content.map((item) => ("text" in item ? item.text : ""))).toEqual([
+      "thinking",
+      "first block",
+      "second block",
+    ])
+    // The input is not mutated.
+    expect(message.content.map((item) => ("text" in item ? item.text : ""))).toEqual(["", "first block", ""])
+  })
+
+  test("a new block restarts the offsets, and ended or cleared blocks are dropped", () => {
+    expect(LiveContent.append("msg_live", "text", 0, "abc")).toBe(0)
+    expect(LiveContent.append("msg_live", "text", 0, "de")).toBe(3)
+    expect(LiveContent.append("msg_live", "text", 1, "x")).toBe(0)
+    LiveContent.end("msg_live", "text", 0)
+    expect(LiveContent.has("msg_live")).toBe(true)
+    LiveContent.end("msg_live", "text", 1)
+    expect(LiveContent.has("msg_live")).toBe(false)
+    LiveContent.append("msg_live", "reasoning", 0, "r")
+    LiveContent.clear("msg_live")
+    expect(LiveContent.has("msg_live")).toBe(false)
+  })
+
+  test("other messages and types pass through unchanged", () => {
+    const message = assistant([{ type: "text", text: "" }] as never)
+    expect(LiveContent.overlay(message)).toBe(message)
+    LiveContent.append("msg_other", "text", 0, "x")
+    expect(LiveContent.overlay(message)).toBe(message)
+  })
+})
