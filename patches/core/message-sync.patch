diff --git a/packages/core/src/session/live-content.ts b/packages/core/src/session/live-content.ts
new file mode 100644
index 0000000000000000000000000000000000000000..410555e11a19b7c3dad25e67e23f048b01eafdb3
--- /dev/null
+++ b/packages/core/src/session/live-content.ts
@@ -0,0 +1,94 @@
+// ocelot: streamed text and reasoning that is not in the database yet.
+//
+// Deltas are live-only: the projection writes an empty block on `*.started` and the full value
+// on `*.ended`, so a read in between (page load, reconnect, a resync after returning to the app)
+// used to get an empty block, and the deltas that followed were appended to it. This keeps what
+// has been published of each open block in memory, and message reads fill it in. Each delta event
+// carries the offset it starts at, so a client can drop what a read already gave it and notice
+// what it missed.
+//
+// One process serves every session, so this is a module-level map keyed by assistant message.
+export * as LiveContent from "./live-content"
+
+import type { SessionMessage } from "@opencode/schema/session-message"
+
+export type Kind = "text" | "reasoning"
+
+type Block = { ordinal: number; value: string }
+type Entry = { text?: Block; reasoning?: Block; touched: number }
+
+const entries = new Map<string, Entry>()
+// An open block whose step died without an end (crash, interrupt before the flush) is dropped
+// once nothing has been appended for this long, and with the step's end in the normal case.
+const staleMs = 10 * 60_000
+let lastSweep = 0
+
+function sweep(now: number) {
+  if (now - lastSweep < 60_000) return
+  lastSweep = now
+  for (const [id, entry] of entries) if (now - entry.touched > staleMs) entries.delete(id)
+}
+
+/** Records a published delta and returns the offset it starts at (the block's length before it). */
+export function append(messageID: string, kind: Kind, ordinal: number, delta: string): number {
+  const now = Date.now()
+  sweep(now)
+  const entry = entries.get(messageID) ?? { touched: now }
+  entries.set(messageID, entry)
+  entry.touched = now
+  const block = entry[kind]
+  if (!block || block.ordinal !== ordinal) {
+    entry[kind] = { ordinal, value: delta }
+    return 0
+  }
+  const offset = block.value.length
+  block.value += delta
+  return offset
+}
+
+/** The block is in the database now (its `*.ended` was projected). */
+export function end(messageID: string, kind: Kind, ordinal: number) {
+  const entry = entries.get(messageID)
+  if (!entry || entry[kind]?.ordinal !== ordinal) return
+  entry[kind] = undefined
+  if (!entry.text && !entry.reasoning) entries.delete(messageID)
+}
+
+/** The step settled: nothing of it is live any more. */
+export function clear(messageID: string) {
+  entries.delete(messageID)
+}
+
+export function has(messageID: string) {
+  return entries.has(messageID)
+}
+
+/**
+ * The message with its open blocks filled in from what has been streamed. Blocks are matched by
+ * ordinal (the n-th text or reasoning block of the step) and only filled while the stored block is
+ * still empty, so a block the projection already completed is never overwritten.
+ */
+export function overlay<M extends SessionMessage.Info>(message: M): M {
+  if (message.type !== "assistant") return message
+  const entry = entries.get(message.id)
+  if (!entry) return message
+  const blocks = [entry.text, entry.reasoning]
+  if (!blocks.some((block) => block?.value)) return message
+  const counts = { text: 0, reasoning: 0 }
+  let changed = false
+  const content = message.content.map((item) => {
+    if (item.type !== "text" && item.type !== "reasoning") return item
+    const ordinal = counts[item.type]++
+    const block = entry[item.type]
+    if (!block || block.ordinal !== ordinal || item.text !== "" || !block.value) return item
+    changed = true
+    return { ...item, text: block.value }
+  })
+  return changed ? ({ ...message, content } as M) : message
+}
+
+/** For tests. */
+export function reset() {
+  entries.clear()
+  lastSweep = 0
+}
