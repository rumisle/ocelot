+  let shownKey = session.identity.sessionKey()
+  createComputed(() => {
+    const key = session.identity.sessionKey()
+    if (key === shownKey) return
+    untrack(() => leavePosition(shownKey))
+    shownKey = key
+  })
+  onCleanup(() => leavePosition(shownKey))
