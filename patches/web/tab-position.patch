+    if (restored.has(key) && performance.now() >= restoringUntil) {
+      const following = state.follow.sessionKey !== key || state.follow.pinned
+      leftFollowing.set(key, following)
+      const position = following ? undefined : positionApi?.capture()
+      if (following || position) writePosition(key, position)
+    }
+    restored.delete(key)
+    restoringUntil = 0
+    restorePages = 0
+    restoreJumped = false
+  }
