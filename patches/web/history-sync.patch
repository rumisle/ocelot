index 0000000000000000000000000000000000000000..20b1c000e34fc000b5f017034a0cc5a3ff889abb
--- /dev/null
+++ b/packages/app/src/runtime/persistence/history-cache.ts
@@ -0,0 +1,171 @@
+// ocelot: the history cache (HistoryCache in @opencode/client/solid/data) in IndexedDB.
+//
+// One "meta" record per session (message order, watermark, when it was last used, the app build)
+// and one "message" record per message, keyed [session key, message id], so a sync writes only
+// the messages that changed. Every record carries the server's update time for its copy and the
+// next sync checks it, so nothing here has to be exact: a failed or interleaved write (two tabs)
+// costs a refetch. Entries from another app build are ignored (the message format may differ).
+import type { HistoryCache, HistoryCacheEntry, HistoryCacheRecord } from "@opencode/client/solid"
+
+const database = "ocelot-history"
+// Least recently used sessions beyond this are dropped.
+export const historySessionLimit = 15
+
+type Meta = {
+  key: string
+  scope: string
+  sessionID: string
+  build: string
+  order: string[]
+  watermark: number
+  cursor?: string
+  used: number
+}
+type Stored = HistoryCacheRecord & { id: string }
+
+function request<T>(value: IDBRequest<T>) {
+  return new Promise<T>((resolve, reject) => {
+    value.addEventListener("success", () => resolve(value.result))
+    value.addEventListener("error", () => reject(value.error))
+  })
+}
+
+function done(transaction: IDBTransaction) {
+  return new Promise<void>((resolve, reject) => {
+    transaction.addEventListener("complete", () => resolve())
+    transaction.addEventListener("error", () => reject(transaction.error))
+    transaction.addEventListener("abort", () => reject(transaction.error ?? new Error("aborted")))
+  })
+}
+
+/** The build of the app this page runs (its entry script); a new release starts a new cache. */
+export function appBuild() {
+  const entry = document.querySelector<HTMLScriptElement>('script[type="module"][src]')?.src
+  return entry ? new URL(entry).pathname : "dev"
+}
+
+export function createHistoryCache(input: { scope: string; build: string; factory?: IDBFactory }): HistoryCache {
+  const factory = input.factory ?? globalThis.indexedDB
+  let opened: Promise<IDBDatabase> | undefined
+  const open = () =>
+    (opened ??= new Promise<IDBDatabase>((resolve, reject) => {
+      const opening = factory.open(database, 1)
+      opening.addEventListener("upgradeneeded", () => {
+        const db = opening.result
+        db.createObjectStore("meta", { keyPath: "key" })
+        db.createObjectStore("message")
+      })
+      opening.addEventListener("success", () => {
+        const db = opening.result
+        // Another tab upgrading the schema: let it, and reopen next time.
+        db.addEventListener("versionchange", () => {
+          db.close()
+          opened = undefined
+        })
+        resolve(db)
+      })
+      opening.addEventListener("error", () => {
+        opened = undefined
+        reject(opening.error)
+      })
+      opening.addEventListener("blocked", () => {
+        opened = undefined
+        reject(new Error("history cache blocked by another tab"))
+      })
+    }))
+  // Opened right away: creating the database on first use took ~0.4 s in Chromium, on the path
+  // of the first transcript read.
+  void open().catch(() => undefined)
+  const key = (sessionID: string) => `${input.scope}\u0000${sessionID}`
+  const range = (sessionKey: string) => IDBKeyRange.bound([sessionKey, ""], [sessionKey, "\uffff"])
+
+  const removeSession = (transaction: IDBTransaction, sessionKey: string) => {
+    transaction.objectStore("meta").delete(sessionKey)
+    transaction.objectStore("message").delete(range(sessionKey))
+  }
+
+  // Drops the least recently used sessions over the limit (or `keep` of them, after a quota error).
+  async function evict(keep = historySessionLimit) {
+    const db = await open()
+    const transaction = db.transaction(["meta", "message"], "readwrite")
+    const metas = await request(transaction.objectStore("meta").getAll() as IDBRequest<Meta[]>)
+    metas
+      .toSorted((a, b) => b.used - a.used)
+      .slice(keep)
+      .forEach((meta) => removeSession(transaction, meta.key))
+    await done(transaction)
+  }
+
+  async function write(sessionID: string, change: Parameters<HistoryCache["write"]>[1]) {
+    const db = await open()
+    const sessionKey = key(sessionID)
+    const transaction = db.transaction(["meta", "message"], "readwrite")
+    const messages = transaction.objectStore("message")
+    const existing = (await request(transaction.objectStore("meta").get(sessionKey))) as Meta | undefined
+    // An entry from another build is replaced, not merged.
+    if (existing && existing.build !== input.build) messages.delete(range(sessionKey))
+    for (const id of change.remove) messages.delete([sessionKey, id])
+    for (const record of change.put)
+      messages.put({ id: record.id, u: record.u, m: record.m } satisfies Stored, [sessionKey, record.id])
+    transaction.objectStore("meta").put({
+      key: sessionKey,
+      scope: input.scope,
+      sessionID,
+      build: input.build,
+      order: [...change.order],
+      watermark: change.watermark,
+      cursor: change.cursor,
+      used: Date.now(),
+    } satisfies Meta)
+    await done(transaction)
+    return existing === undefined
+  }
+
+  async function drop(sessionID: string) {
+    const db = await open()
+    const transaction = db.transaction(["meta", "message"], "readwrite")
+    removeSession(transaction, key(sessionID))
+    await done(transaction)
+  }
+
+  return {
+    drop,
+    async read(sessionID) {
+      const db = await open()
+      const sessionKey = key(sessionID)
+      const transaction = db.transaction(["meta", "message"], "readonly")
+      const [meta, stored] = await Promise.all([
+        request(transaction.objectStore("meta").get(sessionKey)) as Promise<Meta | undefined>,
+        request(transaction.objectStore("message").getAll(range(sessionKey))) as Promise<Stored[]>,
+      ])
+      if (!meta) return undefined
+      if (meta.build !== input.build) {
+        void drop(sessionID).catch(() => undefined)
+        return undefined
+      }
+      // Mark it used without holding up the read.
+      void (async () => {
+        const update = db.transaction("meta", "readwrite")
+        update.objectStore("meta").put({ ...meta, used: Date.now() })
+        await done(update)
+      })().catch(() => undefined)
+      const records = new Map<string, HistoryCacheRecord>()
+      for (const record of stored)
+        if (record && typeof record.u === "number" && record.m?.id === record.id)
+          records.set(record.id, { u: record.u, m: record.m })
+      return { order: meta.order, records, watermark: meta.watermark, cursor: meta.cursor } satisfies HistoryCacheEntry
+    },
+    async write(sessionID, change) {
+      let added: boolean
+      try {
+        added = await write(sessionID, change)
+      } catch (error) {
+        if (!(error instanceof DOMException && error.name === "QuotaExceededError")) throw error
+        // Out of space: keep only the few most recent sessions and try once more.
+        await evict(3)
+        added = await write(sessionID, change)
+      }
+      if (added) await evict().catch(() => undefined)
+    },
+  }
+}
