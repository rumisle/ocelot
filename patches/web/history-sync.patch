+    expect(client.ids()).toEqual(["msg_0008", "msg_0009", "msg_0010", "msg_0011", "msg_0012"])
+    expect(server.requests.map((request) => request.query.include)).toEqual([undefined, "msg_0011,msg_0012"])
+  } finally {
+    client.dispose()
+  }
