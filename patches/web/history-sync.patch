diff --git a/packages/client/src/solid/message-sync.ts b/packages/client/src/solid/message-sync.ts
new file mode 100644
index 0000000000000000000000000000000000000000..20539d891faa88992b3e91016deac561d604638c
--- /dev/null
+++ b/packages/client/src/solid/message-sync.ts
@@ -0,0 +1,98 @@
+// ocelot (patch web/history-sync): the rules for bringing a client's transcript up to date from a
+// message-sync answer, and for streamed deltas that carry their offset. Pure; data.ts wires them.
+import type { SessionMessageAssistant, SessionMessageInfo } from "../promise"
+
+export type SyncAnswer = {
+  readonly ids: readonly string[]
+  readonly updated: readonly number[]
+  readonly data: readonly SessionMessageInfo[]
+}
+
+export type Merged = {
+  /** The new transcript, oldest first: held objects where unchanged, so their rows stay mounted. */
+  readonly messages: SessionMessageInfo[]
+  /** Newer copies of messages the client holds, to merge into them in place. */
+  readonly changed: ReadonlyMap<string, SessionMessageInfo>
+}
+
+/**
+ * The answer lists every message from the oldest the client holds; data comes only for what
+ * changed. A held copy is used for the rest, except one from the cache whose update time differs
+ * from the server's (`verify`). Messages the client got by event while the request was out are
+ * newer than the answer and stay at the end; held ones the answer leaves out are gone. Returns the
+ * ids it has no usable copy of instead, to be asked for.
+ */
+export function mergeSync(input: {
+  readonly held: readonly SessionMessageInfo[]
+  /** Ids held when the request went out. */
+  readonly sent: ReadonlySet<string>
+  /** Rows only this client has (unacknowledged submissions); the caller keeps them. */
+  readonly local: ReadonlySet<string>
+  readonly answer: SyncAnswer
+  readonly verify?: ReadonlyMap<string, number>
+}): Merged | { readonly missing: string[] } {
+  const held = new Map(input.held.map((item) => [item.id, item]))
+  const data = new Map(input.answer.data.map((item) => [item.id, item]))
+  const missing = input.answer.ids.filter(
+    (id, position) =>
+      !data.has(id) &&
+      (!held.has(id) || (input.verify !== undefined && input.verify.get(id) !== input.answer.updated[position])),
+  )
+  if (missing.length > 0) return { missing }
+  const listed = new Set(input.answer.ids)
+  const messages = input.answer.ids.map((id) => held.get(id) ?? data.get(id)!)
+  for (const item of input.held)
+    if (!input.sent.has(item.id) && !listed.has(item.id) && !input.local.has(item.id)) messages.push(item)
+  return { messages, changed: new Map([...data].filter(([id]) => held.has(id))) }
+}
+
+/**
+ * What to write to the history cache after a sync: the newest `limit` messages with their update
+ * times, minus what it already holds. Unfinished steps are left out (their streamed text changes
+ * without a new update time), so they are always fetched.
+ */
+export function cacheChange(input: {
+  readonly ids: readonly string[]
+  readonly updated: readonly number[]
+  readonly version: (id: string) => SessionMessageInfo
+  readonly persisted: ReadonlyMap<string, number>
+  readonly limit: number
+}) {
+  const wanted = new Map<string, number>()
+  const put: { id: string; u: number; m: SessionMessageInfo }[] = []
+  for (let position = Math.max(0, input.ids.length - input.limit); position < input.ids.length; position++) {
+    const id = input.ids[position]!
+    const item = input.version(id)
+    if (item.type === "assistant" && item.time.completed === undefined) continue
+    const u = input.updated[position]!
+    wanted.set(id, u)
+    if (input.persisted.get(id) !== u) put.push({ id, u, m: item })
+  }
+  const remove = [...input.persisted.keys()].filter((id) => !wanted.has(id))
+  return { wanted, put, remove, order: input.ids.slice(-input.limit) }
+}
+
+/**
+ * Applies a streamed delta at its offset: what a read already included is dropped. Returns false
+ * on a gap (deltas missed, or a read older than the stream). Without an offset (an older server)
+ * it appends, as before.
+ */
+export function applyDelta(block: { text: string }, delta: string, offset: number | undefined) {
+  if (offset === undefined) {
+    block.text += delta
+    return true
+  }
+  if (offset > block.text.length) return false
+  if (offset + delta.length > block.text.length) block.text = block.text.slice(0, offset) + delta
+  return true
+}
+
+/** The ordinal-th text or reasoning block of a step, the numbering the server's events use. */
+export function blockAt<K extends "text" | "reasoning">(assistant: SessionMessageAssistant, kind: K, ordinal: number) {
+  let seen = 0
+  for (const item of assistant.content) {
+    if (item.type !== kind) continue
+    if (seen++ === ordinal) return item as Extract<SessionMessageAssistant["content"][number], { type: K }>
+  }
+  return undefined
+}
diff --git a/packages/client/test/fixture/message-server.ts b/packages/client/test/fixture/message-server.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c5b6b5256eed44733e8bac7a225a7113eeed7732
--- /dev/null
+++ b/packages/client/test/fixture/message-server.ts
@@ -0,0 +1,173 @@
+// ocelot: a stateful fake of the message routes (list, get, sync) with the server's semantics:
+// sequence order, update times on a controllable clock, the sync margin, include/held, reset, and
+// streamed text that reads see before the block ends (core/session/live-content.ts).
+import { OpenCode, type SessionMessageInfo } from "../../src/promise"
+
+type Row = { message: SessionMessageInfo; updated: number }
+
+const syncMarginMs = 10_000
+
+function encodeCursor(id: string, order: "asc" | "desc", direction: "previous" | "next") {
+  return Buffer.from(JSON.stringify({ id, order, direction })).toString("base64url")
+}
+
+export function createMessageServer(options?: { sync?: boolean }) {
+  let clock = 1_000_000
+  const rows: Row[] = []
+  // Streamed text not yet "stored", per assistant message id and text-block ordinal.
+  const live = new Map<string, Map<number, string>>()
+  const requests: { path: string; query: Record<string, string> }[] = []
+  // Requests wait on this before answering, when set.
+  let gate: Promise<void> | undefined
+
+  const server = {
+    requests,
+    now: () => clock,
+    tick(ms = 1) {
+      clock += ms
+    },
+    hold() {
+      const released = Promise.withResolvers<void>()
+      gate = released.promise
+      return () => {
+        gate = undefined
+        released.resolve()
+      }
+    },
+    ids: () => rows.map((row) => row.message.id),
+    add(...messages: SessionMessageInfo[]) {
+      for (const message of messages) {
+        clock++
+        rows.push({ message: structuredClone(message), updated: clock })
+      }
+    },
+    update(id: string, fn: (message: SessionMessageInfo) => void) {
+      const row = rows.find((item) => item.message.id === id)
+      if (!row) throw new Error(`no ${id}`)
+      fn(row.message)
+      clock++
+      row.updated = clock
+    },
+    remove(...ids: string[]) {
+      for (const id of ids) {
+        const index = rows.findIndex((row) => row.message.id === id)
+        if (index >= 0) rows.splice(index, 1)
+      }
+    },
+    /** Insert rows again with their old update time (what a branch switch does). */
+    restore(...restored: Row[]) {
+      rows.push(...restored)
+    },
+    row: (id: string) => rows.find((row) => row.message.id === id),
+    setLive(messageID: string, ordinal: number, text: string | undefined) {
+      const blocks = live.get(messageID) ?? new Map<number, string>()
+      if (text === undefined) blocks.delete(ordinal)
+      else blocks.set(ordinal, text)
+      live.set(messageID, blocks)
+    },
+    api: undefined as unknown as ReturnType<typeof OpenCode.make>,
+  }
+
+  function overlay(message: SessionMessageInfo): SessionMessageInfo {
+    const blocks = live.get(message.id)
+    if (!blocks || message.type !== "assistant") return structuredClone(message)
+    let ordinal = 0
+    return {
+      ...structuredClone(message),
+      content: message.content.map((item) => {
+        if (item.type !== "text") return structuredClone(item)
+        const text = blocks.get(ordinal++)
+        return text !== undefined && item.text === "" ? { ...item, text } : structuredClone(item)
+      }),
+    }
+  }
+
+  async function handle(request: Request): Promise<Response> {
+    const url = new URL(request.url)
+    const query = Object.fromEntries(url.searchParams)
+    requests.push({ path: url.pathname, query })
+    if (gate) await gate
+    const sync = url.pathname.match(/^\/api\/session\/[^/]+\/message-sync$/)
+    if (sync) {
+      if (options?.sync === false) return Response.json({ _tag: "RouteNotFound", message: "no route" }, { status: 404 })
+      const watermark = clock
+      const since =
+        query.since === undefined || Number(query.since) > clock ? undefined : Number(query.since) - syncMarginMs
+      const include = new Set((query.include ?? "").split(",").filter(Boolean))
+      let start = 0
+      if (query.from) {
+        start = rows.findIndex((row) => row.message.id === query.from)
+        if (start < 0) return Response.json({ ids: [], updated: [], data: [], watermark, reset: true, cursor: {} })
+      } else start = Math.max(0, rows.length - Number(query.limit ?? 50))
+      const held = query.held ? rows.findIndex((row) => row.message.id === query.held) : -1
+      const heldAt = query.held ? (held < 0 ? Infinity : held) : -1
+      const range = rows.slice(start)
+      const data = range.filter((row, index) => {
+        if (since === undefined) return true
+        const unfinished = row.message.type === "assistant" && row.message.time.completed === undefined
+        return row.updated >= since || unfinished || include.has(row.message.id) || start + index < heldAt
+      })
+      const oldest = range[0]
+      return Response.json({
+        ids: range.map((row) => row.message.id),
+        updated: range.map((row) => row.updated),
+        data: data.map((row) => overlay(row.message)),
+        watermark,
+        reset: false,
+        cursor: oldest ? { next: encodeCursor(oldest.message.id, "desc", "next") } : {},
+      })
+    }
+    const one = url.pathname.match(/^\/api\/session\/[^/]+\/message\/([^/]+)$/)
+    if (one) {
+      const row = rows.find((item) => item.message.id === one[1])
+      return row
+        ? Response.json({ data: overlay(row.message) })
+        : Response.json({ message: "not found" }, { status: 404 })
+    }
+    if (url.pathname.match(/^\/api\/session\/[^/]+\/message$/)) {
+      const limit = Number(query.limit ?? 50)
+      let newestFirst = rows.toReversed()
+      if (query.cursor) {
+        const cursor = JSON.parse(Buffer.from(query.cursor, "base64url").toString()) as { id: string }
+        const index = newestFirst.findIndex((row) => row.message.id === cursor.id)
+        newestFirst = index < 0 ? [] : newestFirst.slice(index + 1)
+      }
+      const page = newestFirst.slice(0, limit)
+      const last = page.at(-1)
+      return Response.json({
+        data: page.map((row) => overlay(row.message)),
+        cursor: last ? { next: encodeCursor(last.message.id, "desc", "next") } : {},
+      })
+    }
+    if (url.pathname.endsWith("/inbox")) return Response.json({ data: [] })
+    if (url.pathname === "/api/session/active") return Response.json({})
+    return Response.json({ message: `unexpected ${url.pathname}` }, { status: 500 })
+  }
+
+  server.api = OpenCode.make({
+    baseUrl: "http://opencode.local",
+    fetch: (async (input: RequestInfo | URL, init?: RequestInit) =>
+      handle(input instanceof Request ? input : new Request(input, init))) as typeof globalThis.fetch,
+  })
+  return server
+}
+
+export function userMessage(index: number): SessionMessageInfo {
+  return {
+    id: `msg_${String(index).padStart(4, "0")}`,
+    type: "user",
+    text: `Message ${index}`,
+    time: { created: index },
+  }
+}
+
+export function assistantMessage(id: string, text: string, completed = true): SessionMessageInfo {
+  return {
+    id,
+    type: "assistant",
+    agent: "build",
+    model: { providerID: "provider", id: "model" },
+    content: [{ type: "text", text }],
+    time: { created: 1, ...(completed ? { completed: 2 } : {}) },
+  } as SessionMessageInfo
+}
