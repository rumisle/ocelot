+test("deltas apply at their offset: duplicates are dropped and a gap refetches the message", async () => {
+  const server = seeded(2)
+  server.add(assistantMessage("msg_reply", "", false))
+  server.setLive("msg_reply", 0, "Hello")
+  const client = setup(server)
+  const text = () => {
+    const reply = client.data.session.message.get(sessionID, "msg_reply")
+    return reply?.type === "assistant" && reply.content[0]?.type === "text" ? reply.content[0].text : undefined
+  }
+  try {
+    await client.data.session.message.sync(sessionID)
+    expect(text()).toBe("Hello")
+    // Already part of the read.
+    client.emit(textDelta("Hel", 0))
+    client.emit(textDelta("lo", 3))
+    expect(text()).toBe("Hello")
+    client.emit(textDelta(", wor", 5))
+    expect(text()).toBe("Hello, wor")
+    // Missed ", wor" + "ld" + "!" while away; the next delta starts at 13.
+    server.setLive("msg_reply", 0, "Hello, world! How")
+    const release = server.hold()
+    client.emit(textDelta(" are", 17))
+    await wait(() => server.requests.some((request) => request.path.endsWith("/message/msg_reply")))
+    // Held while the refetch runs, then replayed on the fresh copy.
+    client.emit(textDelta(" you", 21))
+    release()
+    await wait(() => text() === "Hello, world! How are you")
+  } finally {
+    client.dispose()
+  }
+})
