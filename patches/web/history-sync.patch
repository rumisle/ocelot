+    expect(second.data.session.message.get(sessionID, "msg_0030")).toMatchObject({ text: "changed" })
+    expect(second.data.session.message.get(sessionID, "msg_0025")).toMatchObject({ text: "Message 25" })
+    // One request with the watermark, one for the record that was missing.
+    expect(server.requests.map((request) => [request.query.from, request.query.include])).toEqual([
