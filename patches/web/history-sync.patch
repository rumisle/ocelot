+test("the cache skips unfinished steps and recovers from a failed write", async () => {
+  const server = seeded(3)
+  server.add(assistantMessage("msg_streaming", "", false))
+  const memory = memoryCache()
+  const client = setup(server, { historyCache: memory.cache })
+  try {
+    memory.failNextWrite()
+    await client.data.session.message.sync(sessionID)
+    await flush()
+    expect(memory.drops()).toBe(1)
+    expect(memory.sessions.has(sessionID)).toBe(false)
+    server.update("msg_streaming", (message) => {
+      if (message.type === "assistant") {
+        message.content = [{ type: "text", text: "done" }]
+        message.time.completed = 3
+      }
+    })
+    await client.resync()
+    await flush()
+    // Everything is written again after the failure, now including the finished step.
+    expect([...memory.sessions.get(sessionID)!.records.keys()]).toEqual([...server.ids()])
+    expect(memory.writes.at(-1)!.put).toHaveLength(4)
+  } finally {
+    client.dispose()
+  }
+})
