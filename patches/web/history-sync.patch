+  // Meanwhile: one cached message changed, one deleted, two added; one record went missing.
+  server.tick(60_000)
+  server.update("msg_0030", (message) => {
+    if (message.type === "user") message.text = "changed"
+  })
+  server.remove("msg_0031")
+  server.add(userMessage(41), userMessage(42))
+  memory.sessions.get(sessionID)!.records.delete("msg_0025")
+
+  const release = server.hold()
+  const second = setup(server, { historyCache: memory.cache })
+  try {
+    server.requests.length = 0
