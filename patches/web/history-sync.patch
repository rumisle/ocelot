+    sent: new Set(["msg_a", "msg_b", "msg_c", "msg_local"]),
+    local: new Set(["msg_local"]),
+    answer: { ids: ["msg_a", "msg_c", "msg_d"], updated: [1, 2, 3], data: [user("msg_c", "new"), d!] },
+  })
+  if ("missing" in merged) throw new Error("unexpected")
+  expect(merged.messages.map((item) => item.id)).toEqual(["msg_a", "msg_c", "msg_d", "msg_late"])
+  expect(merged.messages[0]).toBe(a!)
+  expect(merged.messages[1]).toBe(c!)
+  expect([...merged.changed.keys()]).toEqual(["msg_c"])
