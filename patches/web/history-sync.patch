--- /dev/null
+++ b/packages/client/test/fixture/message-sync.ts
@@ -0,0 +1,46 @@
+// ocelot: answers /message-sync through a mock that only implements session.message.list, so
+// tests written for the full transcript read keep their request accounting (the mock sees the
+// list requests a sync stands for, not the sync itself). Every message is sent as changed.
+export function serveMessageSync(fetch: typeof globalThis.fetch): typeof globalThis.fetch {
+  return (async (input: RequestInfo | URL, init?: RequestInit) => {
+    const request = input instanceof Request ? input : new Request(input, init)
+    const url = new URL(request.url)
+    const match = url.pathname.match(/^\/api\/session\/([^/]+)\/message-sync$/)
+    if (!match) return fetch(input, init)
+    const from = url.searchParams.get("from")
+    const collected: { id: string }[] = []
+    let cursor: string | undefined
+    let list = new URL(`/api/session/${match[1]}/message`, url)
+    if (from) list.searchParams.set("limit", "200")
+    else {
+      list.searchParams.set("limit", url.searchParams.get("limit") ?? "20")
+      list.searchParams.set("order", "desc")
+    }
+    for (;;) {
+      const response = await fetch(new Request(list, { signal: request.signal }))
+      if (!response.ok) return response
+      const body = (await response.json()) as { data: { id: string }[]; cursor?: { next?: string } }
+      collected.push(...body.data)
+      cursor = body.cursor?.next
+      if (!from || !cursor || collected.some((item) => item.id === from)) break
+      list = new URL(`/api/session/${match[1]}/message`, url)
+      list.searchParams.set("limit", "200")
+      list.searchParams.set("cursor", cursor)
+    }
+    let data = collected.toReversed()
+    if (from) {
+      const start = data.findIndex((item) => item.id === from)
+      if (start < 0)
+        return Response.json({ ids: [], updated: [], data: [], watermark: Date.now(), reset: true, cursor: {} })
+      data = data.slice(start)
+    }
+    return Response.json({
+      ids: data.map((item) => item.id),
+      updated: data.map(() => 0),
+      data,
+      watermark: Date.now(),
+      reset: false,
+      cursor: cursor ? { next: cursor } : {},
+    })
+  }) as typeof globalThis.fetch
+}
