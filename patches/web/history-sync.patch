+const sessionID = "ses_sync"
+
+function memoryCache() {
+  const sessions = new Map<
+    string,
+    { order: string[]; watermark: number; cursor?: string; records: Map<string, HistoryCacheRecord> }
+  >()
+  const writes: HistoryCacheChange[] = []
+  let failNext = false
+  let drops = 0
+  const cache: HistoryCache = {
+    async read(id) {
+      const entry = sessions.get(id)
+      if (!entry) return undefined
+      return {
+        order: [...entry.order],
+        watermark: entry.watermark,
+        cursor: entry.cursor,
+        records: new Map(entry.records),
+      }
+    },
+    async write(id, change) {
+      writes.push(change)
+      if (failNext) {
+        failNext = false
+        throw new Error("quota")
+      }
+      const entry = sessions.get(id) ?? { order: [], watermark: 0, records: new Map() }
+      for (const record of change.put) entry.records.set(record.id, { u: record.u, m: structuredClone(record.m) })
+      for (const removed of change.remove) entry.records.delete(removed)
+      entry.order = [...change.order]
+      entry.watermark = change.watermark
+      entry.cursor = change.cursor
+      sessions.set(id, entry)
+    },
+    async drop(id) {
+      drops++
+      sessions.delete(id)
+    },
+  }
+  return {
+    cache,
+    sessions,
+    writes,
+    failNextWrite: () => (failNext = true),
+    drops: () => drops,
+  }
+}
+
+function setup(server: ReturnType<typeof createMessageServer>, options?: Partial<CreateDataInput>) {
+  const listeners = new Set<Parameters<CreateDataInput["event"]["listen"]>[0]>()
+  return createRoot((dispose) => {
+    const data = createData({
+      api: () => server.api,
+      directory: "/project",
+      initialMessageLimit: () => 5,
+      event: {
+        on: () => () => {},
+        listen(handler) {
+          listeners.add(handler)
+          return () => listeners.delete(handler)
+        },
+      },
+      ...options,
+    })
+    const emit = (event: Omit<OpenCodeEvent, "id" | "created"> & { id?: string }) => {
+      const full = { id: `evt_${Math.random()}`, created: 1, ...event } as OpenCodeEvent
+      listeners.forEach((listener) => listener({ name: full.type, details: full }))
+    }
+    const ids = () => data.session.message.list(sessionID).map((item) => item.id)
+    const resync = async () => {
+      data.session.message.invalidate(sessionID)
+      await data.session.message.sync(sessionID)
+    }
+    return { data, dispose, emit, ids, resync }
+  })
+}
+
+const flush = () => new Promise((resolve) => setTimeout(resolve, 0))
+const wait = async (condition: () => boolean, timeout = 3_000) => {
+  const start = Date.now()
+  while (!condition()) {
+    if (Date.now() - start > timeout) throw new Error("timed out")
+    await new Promise((resolve) => setTimeout(resolve, 5))
+  }
+}
+
+function seeded(count: number, options?: { sync?: boolean }) {
+  const server = createMessageServer(options)
+  server.add(...Array.from({ length: count }, (_, index) => userMessage(index + 1)))
+  // Long enough ago that the sync margin does not resend everything.
+  server.tick(60_000)
+  return server
+}
