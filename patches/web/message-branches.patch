diff --git a/packages/app/src/session/revert.ts b/packages/app/src/session/revert.ts
index 4bb7bc1add446d8bd6e674db5422beeaec31ad47..8b09699f665eb27adcf47a6f6eca06c79dfa0383 100644
--- a/packages/app/src/session/revert.ts
+++ b/packages/app/src/session/revert.ts
@@ -1,4 +1,6 @@
 import type { SessionMessageUser } from "@opencode/client/promise"
+import type { SessionUserBranch } from "@opencode/session-ui/message"
+import { createEffect } from "solid-js"
 import { useComposerState } from "@/composer/persistence"
 import { useData } from "@/runtime/server/current"
 import { useServerSDK } from "@/runtime/server/client"
@@ -110,7 +112,35 @@ export function createSessionRevert(input: {
     owner.run(() => input.setActiveMessage(messages.at(-1)))
   }
 
-  return { to, undo, redo }
+  // ocelot: conversation branches (patch core/message-branches). Sending after an edit keeps
+  // the old messages as a branch; the switcher on the edited message swaps between them.
+  createEffect(() => {
+    const sessionID = input.session.identity.params.id
+    if (sessionID) void data.session.branch.sync(sessionID).catch(() => undefined)
+  })
+  const branch = (messageID: string): SessionUserBranch | undefined => {
+    const sessionID = input.session.identity.params.id
+    if (!sessionID) return
+    const point = data.session.branch.list(sessionID).find((item) => item.messageID === messageID)
+    if (!point) return
+    const index = point.alternatives.findIndex((item) => item.branchID === null)
+    if (index < 0) return
+    const go = (item: (typeof point.alternatives)[number] | undefined) => {
+      const branchID = item?.branchID
+      if (!branchID) return
+      return async () => {
+        await request(() => data.session.branch.switch(sessionID, branchID))
+      }
+    }
+    return {
+      position: index + 1,
+      count: point.alternatives.length,
+      previous: go(point.alternatives[index - 1]),
+      next: go(point.alternatives[index + 1]),
+    }
+  }
+
+  return { to, undo, redo, branch }
 }
 
 export type SessionRevert = ReturnType<typeof createSessionRevert>
