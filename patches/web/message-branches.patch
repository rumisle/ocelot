+                  onClick={(event) => {
+                    event.stopPropagation()
+                    void switchBranch(current().next)
+                  }}
+                  aria-label={i18n.t("ui.message.branchNext")}
+                />
+              </div>
+            )}
+          </Show>
           <Show when={props.actions?.revert}>
             <MessageActionButton
-              icon="reset"
+              icon="edit"
               label={i18n.t("ui.message.revertMessage")}
