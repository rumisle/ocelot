 export type SessionUserActions = {
   openAttachment?: (file: PromptFileAttachment) => void
   revert?: (input: { sessionID: string; messageID: string }) => Promise<void> | void
+  /** ocelot: the version switcher of a user message that starts a conversation branch. */
+  branch?: (messageID: string) => SessionUserBranch | undefined
+}
+
+/** ocelot: where a user message sits among its alternatives (patch core/message-branches). */
+export type SessionUserBranch = {
+  /** 1-based position among the alternatives, oldest first. */
+  position: number
+  count: number
+  previous?: () => Promise<void> | void
+  next?: () => Promise<void> | void
 }
