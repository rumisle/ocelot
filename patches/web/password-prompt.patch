From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rumisle <why-excuse-quail@duck.com>
Date: Fri, 25 Sep 2026 15:18:17 +0800
Subject: app+server: ask for a server's password in the app, not the browser's
 dialog

A request without the right password got a 401 with WWW-Authenticate: Basic,
so browsers showed their own login dialog and the app sat at "Loading". The
dialog's answer is never saved: an iOS home screen app (its own storage,
separate from Safari's, so the pairing link's password isn't there) asked on
every launch.

The server now sends the Basic challenge only to page loads and non-browser
clients (no Sec-Fetch-Mode, or navigate); the app's own requests get a bare
401. The app checks each HTTP server's /api/info, and on 401 asks for the
password, checks it, saves it with the server and reloads.

Ocelot-Patch: web/password-prompt

diff --git a/packages/app/src/servers/connect/password-prompt.tsx b/packages/app/src/servers/connect/password-prompt.tsx
new file mode 100644
index 000000000..e21121aef
--- /dev/null
+++ b/packages/app/src/servers/connect/password-prompt.tsx
@@ -0,0 +1,135 @@
+import { Button } from "@opencode/ui/button"
+import { Dialog, DialogBody, DialogFooter, DialogHeader, DialogTitle } from "@opencode/ui/dialog"
+import { Divider } from "@opencode/ui/divider"
+import { TextInput } from "@opencode/ui/text-input"
+import { useDialog } from "@opencode/ui/context/dialog"
+import { Show, createEffect, createSignal } from "solid-js"
+import { ServerConnection, useServers } from "@/runtime/server/registry"
+import { usePlatform } from "@/runtime/platform/platform"
+import { useLanguage } from "@/runtime/i18n/language"
+import { authTokenFromCredentials } from "@/runtime/server/api"
+import "@/settings/settings.css"
+
+type Check = (http: ServerConnection.HttpBase) => Promise<number>
+
+/**
+ * Asks for a server's password when it answers 401, and saves it with the server. Without this, a
+ * missing or wrong password left the app at "Loading" behind the browser's own login dialog, whose
+ * answer is never saved (so an iOS home screen app asked again on every launch).
+ */
+export function ServerPasswordPrompt() {
+  const servers = useServers()
+  const dialog = useDialog()
+  const platform = usePlatform()
+  const fetcher = platform.fetch ?? globalThis.fetch
+  const asked = new Set<string>()
+
+  const check: Check = (http) =>
+    fetcher(new URL("/api/info", http.url), {
+      headers: http.password
+        ? { Authorization: `Basic ${authTokenFromCredentials({ password: http.password })}` }
+        : undefined,
+    }).then(
+      (response) => response.status,
+      () => 0,
+    )
+
+  createEffect(() => {
+    if (!servers.hydrated()) return
+    const list = servers.list.filter((conn): conn is ServerConnection.Http => conn.type === "http")
+    void (async () => {
+      for (const conn of list) {
+        const key = ServerConnection.key(conn)
+        if (asked.has(key) || (await check(conn.http)) !== 401) continue
+        asked.add(key)
+        dialog.show(() => (
+          <DialogServerPassword
+            server={conn}
+            check={check}
+            onSave={(password) => {
+              servers.add({ ...conn, http: { ...conn.http, password } })
+              // Every connection to this server was made with the old credentials.
+              location.reload()
+            }}
+          />
+        ))
+        return
+      }
+    })()
+  })
+
+  return null
+}
+
+function DialogServerPassword(props: {
+  server: ServerConnection.Http
+  check: Check
+  onSave: (password: string) => void
+}) {
+  const dialog = useDialog()
+  const language = useLanguage()
+  const [password, setPassword] = createSignal("")
+  const [busy, setBusy] = createSignal(false)
+  const [error, setError] = createSignal<string>()
+  const host = () => {
+    try {
+      return new URL(props.server.http.url).host
+    } catch {
+      return props.server.http.url
+    }
+  }
+
+  const submit = async () => {
+    if (!password() || busy()) return
+    setBusy(true)
+    setError(undefined)
+    const status = await props.check({ ...props.server.http, password: password() })
+    setBusy(false)
+    if (status === 401) return setError("Wrong password")
+    if (status === 0) return setError("Can't reach the server")
+    props.onSave(password())
+  }
+
+  return (
+    <Dialog fit class="settings-server-dialog">
+      <DialogHeader hideClose={true}>
+        <DialogTitle>{props.server.displayName ?? host()}</DialogTitle>
+      </DialogHeader>
+      <Divider />
+      <DialogBody class="flex w-full min-w-0 flex-1 flex-col px-4 pt-4 pb-2">
+        <div class="flex w-full min-w-0 flex-col gap-2">
+          <label class="settings-server-dialog-label">{language.t("dialog.server.add.password")}</label>
+          <TextInput
+            type="password"
+            appearance="large"
+            class="!w-full self-stretch"
+            autofocus
+            value={password()}
+            invalid={!!error()}
+            disabled={busy()}
+            aria-describedby={error() ? "dialog-server-password-error" : undefined}
+            onInput={(event) => setPassword(event.currentTarget.value)}
+            onKeyDown={(event) => {
+              if (event.key !== "Enter" || event.isComposing) return
+              event.preventDefault()
+              void submit()
+            }}
+          />
+          <Show when={error()}>
+            <span id="dialog-server-password-error" class="settings-server-dialog-error" role="alert">
+              {error()}
+            </span>
+          </Show>
+        </div>
+      </DialogBody>
+      <DialogFooter>
+        <Button variant="neutral" disabled={busy()} onClick={() => dialog.close()}>
+          {language.t("common.cancel")}
+        </Button>
+        <Button variant="contrast" disabled={busy() || !password()} onClick={() => void submit()}>
+          {busy() ? language.t("dialog.server.add.checking") : language.t("common.save")}
+        </Button>
+      </DialogFooter>
+    </Dialog>
+  )
+}
