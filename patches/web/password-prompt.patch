 const WWW_AUTHENTICATE = 'Basic realm="Secure Area"'
 
+/**
+ * Whether a 401 should carry the Basic challenge, which makes browsers show their own login dialog.
+ * Only for page loads and non-browser clients: the web app's own requests (fetch, EventSource) carry
+ * `Sec-Fetch-Mode: cors`/`same-origin`, and the app asks for the password itself and saves it; the
+ * browser's dialog answer is never saved (an iOS home screen app asked again on every launch).
+ */
+export function wantsBasicChallenge(request: HttpServerRequest.HttpServerRequest) {
+  const mode = request.headers["sec-fetch-mode"]
+  return mode === undefined || mode === "navigate"
+}
+
