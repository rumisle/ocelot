From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rumisle <why-excuse-quail@duck.com>
Date: Wed, 14 Oct 2026 11:12:51 +0800
Subject: client/data: catalog update events refetch only loaded locations

Every location the server boots (a subagent's worktree, say) announces its
catalogs: provider, model, agent, command, skill, reference, integration, mcp.
The client refetched each one for every location, loaded here or not, so a
server restart with ~30 working subagents sent hundreds of requests for
locations this page never shows. Now an event refetches only what this page
has loaded (or is loading) for that location; anything else loads when read.

Ocelot-Patch: web/catalog-events

diff --git a/packages/client/src/solid/data.ts b/packages/client/src/solid/data.ts
index c7a5b1928771ab96249eb4f9dc4ac79a98bbdb72..3490630ec7d9a82c42d826ae98f1738fa6c7e2a9 100644
--- a/packages/client/src/solid/data.ts
+++ b/packages/client/src/solid/data.ts
@@ -1609,24 +1609,35 @@ export function createData(config: CreateDataInput) {
 
     if (!event.location) return
     const location = event.location
+    // ocelot: refetch only what this page has loaded for the location. Every location the server
+    // boots (each subagent's worktree, say) announces its catalogs, and refetching each one sent
+    // hundreds of requests for locations nothing here shows; an unloaded one loads when read.
+    const held = (field: keyof LocationData) =>
+      store.location[locationKey(location)]?.[field] !== undefined ||
+      sync.has(`location.${field}:${locationKey(location)}`)
     switch (event.type) {
       case "provider.updated":
+        if (!held("provider")) break
         result.location.provider.invalidate(location)
         refresh(() => result.location.provider.sync(location))
         break
       case "model.updated":
+        if (!held("model")) break
         result.location.model.invalidate(location)
         refresh(() => result.location.model.sync(location))
         break
       case "agent.updated":
+        if (!held("agent")) break
         result.location.agent.invalidate(location)
         refresh(() => result.location.agent.sync(location))
         break
       case "command.updated":
+        if (!held("command")) break
         result.location.command.invalidate(location)
         refresh(() => result.location.command.sync(location))
         break
       case "skill.updated":
+        if (!held("skill")) break
         result.location.skill.invalidate(location)
         refresh(() => result.location.skill.sync(location))
         break
@@ -1662,38 +1673,35 @@ export function createData(config: CreateDataInput) {
         }))
         break
       case "reference.updated":
+        if (!held("reference")) break
         result.location.reference.invalidate(location)
         refresh(() => result.location.reference.sync(location))
         break
-      case "integration.updated":
-        result.location.integration.invalidate(location)
-        result.location.model.invalidate(location)
-        result.location.provider.invalidate(location)
-        refresh(() =>
-          Promise.all([
-            result.location.integration.sync(location),
-            result.location.model.sync(location),
-            result.location.provider.sync(location),
-          ]),
-        )
+      case "integration.updated": {
+        const fields = (["integration", "model", "provider"] as const).filter(held)
+        for (const field of fields) result.location[field].invalidate(location)
+        if (fields.length > 0) refresh(() => Promise.all(fields.map((field) => result.location[field].sync(location))))
         break
+      }
       case "config.updated":
         result.location.config.invalidate(location)
         if (result.location.config.list(location) !== undefined || sync.has(`location.config:${locationKey(location)}`))
           refresh(() => result.location.config.sync(location))
-        refresh(() => result.location.websearch.refresh(location))
+        if (held("websearch")) refresh(() => result.location.websearch.refresh(location))
         break
       case "websearch.updated":
-        refresh(() => result.location.websearch.refresh(location))
+        if (held("websearch")) refresh(() => result.location.websearch.refresh(location))
         break
       // Authenticating an MCP integration reconnects its server, which emits mcp.status.changed,
       // so the mcp list syncs here rather than off integration.updated. The server emits one event
       // per MCP server as each settles, so a location booting nine servers emitted nine refetches.
       case "mcp.status.changed":
+        if (!held("mcpServer")) break
         result.location.mcp.server.invalidate(location)
         settle(`mcp.status:${locationKey(location)}`, () => result.location.mcp.server.sync(location))
         break
       case "mcp.resources.changed":
+        if (!held("mcpResource")) break
         result.location.mcp.resource.invalidate(location)
         refresh(() => result.location.mcp.resource.sync(location))
         break
