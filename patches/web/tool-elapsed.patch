diff --git a/packages/session-ui/src/components/tool-elapsed.tsx b/packages/session-ui/src/components/tool-elapsed.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..84b7894f401f05a13e80aac060c4ac9d34af109e
--- /dev/null
+++ b/packages/session-ui/src/components/tool-elapsed.tsx
@@ -0,0 +1,48 @@
+import { createContext, createEffect, createMemo, createSignal, onCleanup, Show, useContext, type Accessor } from "solid-js"
+import { useI18n } from "@opencode/ui/context/i18n"
+
+/**
+ * ocelot: how long a tool call ran (from `time.ran` to `time.completed`), next to its name like
+ * "Thought 1s". Counts up while it runs; calls under a second show nothing.
+ */
+export type ToolTime = { readonly ran?: number; readonly completed?: number }
+
+/** The current tool call's time, provided by ToolDisplay for the triggers its renderers build. */
+export const ToolTimeContext = createContext<Accessor<ToolTime | undefined>>()
+
+export function ToolElapsed(props: { time?: ToolTime }) {
+  const i18n = useI18n()
+  const context = useContext(ToolTimeContext)
+  const time = () => props.time ?? context?.()
+  const [now, setNow] = createSignal(Date.now())
+  createEffect(() => {
+    const current = time()
+    if (current?.ran === undefined || current.completed !== undefined) return
+    setNow(Date.now())
+    const timer = setInterval(() => setNow(Date.now()), 1_000)
+    onCleanup(() => clearInterval(timer))
+  })
+  const text = createMemo(() => {
+    const current = time()
+    if (current?.ran === undefined) return undefined
+    const ms = (current.completed ?? now()) - current.ran
+    if (!(ms >= 1_000)) return undefined
+    const total = current.completed === undefined ? Math.floor(ms / 1_000) : Math.round(ms / 1_000)
+    const numfmt = new Intl.NumberFormat(i18n.locale())
+    if (total < 60) return i18n.t("ui.message.duration.seconds", { count: numfmt.format(total) })
+    return i18n.t("ui.message.duration.minutesSeconds", {
+      minutes: numfmt.format(Math.floor(total / 60)),
+      seconds: numfmt.format(total % 60),
+    })
+  })
+  return <Show when={text()}>{(value) => <span data-slot="tool-elapsed">{value()}</span>}</Show>
+}
+
+/** The span a group of calls covered: first start to last end, running while any call runs. */
+export function groupTime(times: readonly ToolTime[]): ToolTime | undefined {
+  const ran = times.flatMap((time) => (time.ran === undefined ? [] : [time.ran]))
+  if (ran.length === 0) return undefined
+  const running = times.some((time) => time.ran !== undefined && time.completed === undefined)
+  const completed = times.flatMap((time) => (time.completed === undefined ? [] : [time.completed]))
+  return { ran: Math.min(...ran), completed: running ? undefined : Math.max(...completed) }
+}
