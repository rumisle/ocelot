Subject: session-ui/message: drop agent and model from message meta
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

User messages no longer show "Build · <model> · <time>" under the bubble (the
revert and copy buttons stay), and the line under an assistant reply shows only
the turn's duration (and "Interrupted"), not the agent and model.

Ocelot-Patch: web/message-meta

diff --git a/packages/session-ui/component-tests/session-timeline-mobile.spec.ts b/packages/session-ui/component-tests/session-timeline-mobile.spec.ts
index 90dc100c9..4d6c7a2de 100644
--- a/packages/session-ui/component-tests/session-timeline-mobile.spec.ts
+++ b/packages/session-ui/component-tests/session-timeline-mobile.spec.ts
@@ -18,10 +18,10 @@ story.describe("touch timeline", () => {
       await expect(actions.getByRole("button", { name: action.name, exact: true })).toBeVisible()
     }
 
-    await expect(timeline.locator('[data-slot="user-message-meta"]')).toContainText("Build")
-    await expect(timeline.locator('[data-slot="user-message-meta-tail"]')).not.toBeEmpty()
-    await expect(timeline.locator('[data-slot="text-part-meta"]')).toContainText("Build")
-    await expect(timeline.locator('[data-slot="text-part-meta"]')).toContainText("Sonnet")
+    // ocelot: no agent/model/time on user messages; assistant meta is the duration only.
+    await expect(timeline.locator('[data-slot="user-message-meta"]')).toHaveCount(0)
+    await expect(timeline.locator('[data-slot="text-part-meta"]')).not.toContainText("Build")
+    await expect(timeline.locator('[data-slot="text-part-meta"]')).not.toContainText("Sonnet")
   })
 
   story("keeps shell copy visible without hover", async ({ mount }) => {
