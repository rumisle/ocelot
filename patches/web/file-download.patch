+// ocelot: save the file. It is read again through the session's server: the loaded content is decoded
+// text, or empty for large and unknown binaries.
+export function DownloadButton(props: { session: SessionView; path: string; iconOnly?: boolean }) {
+  const ctx = useExtension()
+  const [busy, setBusy] = createSignal(false)
+  const run = () => {
+    const file = props.session.file
+    const name = getFilename(props.path)
+    const request = file.absolute(props.path)
+      ? { path: name, location: { directory: getDirectory(props.path) } }
+      : { path: props.path, location: { directory: props.session.directory } }
+    setBusy(true)
+    void props.session.server.client.file
+      .read(request)
+      .then(
+        (bytes) => {
+          const url = URL.createObjectURL(new Blob([new Uint8Array(bytes)], { type: "application/octet-stream" }))
+          const anchor = document.createElement("a")
+          anchor.href = url
+          anchor.download = name
+          anchor.click()
+          setTimeout(() => URL.revokeObjectURL(url), 60_000)
+        },
+        (error: unknown) =>
+          showToast({
+            variant: "error",
+            title: ctx.t("view.download.failed", { name }),
+            description: error instanceof Error ? error.message : String(error),
+          }),
+      )
+      .finally(() => setBusy(false))
+  }
+  return (
+    <Show
+      when={props.iconOnly}
+      fallback={
+        <Button size="small" variant="ghost" icon="download" disabled={busy()} onClick={run}>
+          {ctx.t("view.download")}
+        </Button>
+      }
+    >
+      <Tooltip value={ctx.t("view.download")} placement="bottom">
+        <IconButton
+          size="small"
+          variant="ghost"
+          icon={<Icon name="download" size="small" />}
+          disabled={busy()}
+          onClick={run}
+          aria-label={ctx.t("view.download")}
+        />
+      </Tooltip>
+    </Show>
+  )
+}
