+export function DownloadButton(props: { path: string; iconOnly?: boolean }) {
+  const language = useLanguage()
+  const file = useFile()
+  const [busy, setBusy] = createSignal(false)
+  const run = () => {
+    setBusy(true)
+    void file.download(props.path).finally(() => setBusy(false))
+  }
+  return (
+    <Show
+      when={props.iconOnly}
+      fallback={
+        <Button size="small" variant="ghost" icon="download" disabled={busy()} onClick={run}>
+          {language.t("file.view.download")}
+        </Button>
+      }
+    >
+      <Tooltip value={language.t("file.view.download")} placement="bottom">
+        <IconButton
+          size="small"
+          variant="ghost"
+          icon={<Icon name="download" size="small" />}
+          disabled={busy()}
+          onClick={run}
+          aria-label={language.t("file.view.download")}
+        />
+      </Tooltip>
+    </Show>
+  )
+}
