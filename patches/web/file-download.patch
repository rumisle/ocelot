+    // ocelot: save a file. Read again, since the loaded content is decoded text, or empty for large
+    // or unknown binaries.
+    const download = (input: string) => {
+      const file = path.normalize(input)
+      if (!file) return Promise.resolve()
+      const directory = scope()
+      const request = path.absolute(file)
+        ? { path: getFilename(file), location: { directory: getDirectory(file) } }
+        : { path: file, location: { directory } }
+      return serverSDK.api.file.read(request).then(
+        (bytes) => {
+          const url = URL.createObjectURL(new Blob([new Uint8Array(bytes)], { type: "application/octet-stream" }))
+          const anchor = document.createElement("a")
+          anchor.href = url
+          anchor.download = getFilename(file)
+          anchor.click()
+          setTimeout(() => URL.revokeObjectURL(url), 60_000)
+        },
+        (error) =>
+          showToast({
+            variant: "error",
+            title: language.t("toast.file.loadFailed.title"),
+            description: formatServerError(error, language.t, language.t("error.chain.unknown")),
+          }),
+      )
+    }
+
