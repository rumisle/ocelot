index 0000000000000000000000000000000000000000..ed10eee25dea1e9e6a98f45c5e2793a86b3553a6
--- /dev/null
+++ b/packages/app/src/session/timeline/position-memory.ts
@@ -0,0 +1,55 @@
+/**
+ * ocelot: where each session's timeline was left, so a reload (iOS discarding the page, a new
+ * tab) reopens it there, like Telegram. Kept per device in localStorage.
+ *
+ * A position is the row at the top of the viewport (its timeline key, with the turn's user
+ * message as a fallback when the row is gone, e.g. regrouped by another timeline preset) and how
+ * far the viewport's top sits below that row's top. A timeline that follows the newest content
+ * has no entry: it reopens at the bottom.
+ */
+export type TimelinePosition = {
+  readonly key: string
+  readonly turn: string
+  readonly offset: number
+}
+
+const storageKey = "ocelot.timeline.position.v1"
+const limit = 100
+
+type Stored = Record<string, TimelinePosition & { readonly at: number }>
+
+function load(): Stored {
+  try {
+    const value = JSON.parse(localStorage.getItem(storageKey) ?? "{}")
+    return value && typeof value === "object" ? (value as Stored) : {}
+  } catch {
+    return {}
+  }
+}
+
+export function readPosition(sessionKey: string): TimelinePosition | undefined {
+  const entry = load()[sessionKey]
+  if (!entry || typeof entry.key !== "string" || typeof entry.turn !== "string" || !Number.isFinite(entry.offset))
+    return undefined
+  return { key: entry.key, turn: entry.turn, offset: entry.offset }
+}
+
+/** Saves a position, or forgets it (`undefined`: the timeline is at the bottom). */
+export function writePosition(sessionKey: string, position: TimelinePosition | undefined) {
+  try {
+    const stored = load()
+    if (position === undefined) {
+      if (!(sessionKey in stored)) return
+      delete stored[sessionKey]
+    } else {
+      stored[sessionKey] = { ...position, offset: Math.round(position.offset), at: Date.now() }
+      const keys = Object.keys(stored)
+      if (keys.length > limit)
+        keys
+          .sort((a, b) => stored[a]!.at - stored[b]!.at)
+          .slice(0, keys.length - limit)
+          .forEach((key) => delete stored[key])
+    }
+    localStorage.setItem(storageKey, JSON.stringify(stored))
+  } catch {}
+}
