+  // ocelot: the row at the top of the viewport and how far the viewport's top sits below it.
+  function capturePosition(): TimelinePosition | undefined {
+    const root = listRoot()
+    if (!active() || !root || !virtualContent) return undefined
+    const line = root.getBoundingClientRect().top + topOffset()
+    let best: { element: HTMLElement; top: number } | undefined
+    for (const element of virtualContent.querySelectorAll<HTMLElement>("[data-timeline-key]")) {
+      const rect = element.getBoundingClientRect()
+      if (rect.height === 0 || rect.bottom <= line + 1) continue
+      if (!best || rect.top < best.top) best = { element, top: rect.top }
+    }
+    const key = best?.element.dataset.timelineKey
+    const row = key ? rowByKey().get(key) : undefined
+    if (!best || !key || !row) return undefined
+    return { key, turn: row.userMessageID, offset: line - best.top }
+  }
+
+  // Scrolls the saved row (or its turn's first row) to the top, then corrects against real
+  // layout for a few frames while rows around it mount and measure.
+  function restorePosition(position: TimelinePosition) {
+    const exact = rows().findIndex((row) => TimelineRow.key(row) === position.key)
+    const index = exact >= 0 ? exact : input.projection.messageRowIndex().get(position.turn)
+    if (index === undefined || !rows()[index]) return false
+    const key = TimelineRow.key(rows()[index]!)
+    const offset = exact >= 0 ? position.offset : 0
+    prepareNavigation()
+    virtualizer.scrollToIndex(index, { align: "start" })
+    let frames = 0
+    let stable = 0
+    const refine = () => {
+      const root = listRoot()
+      if (!active() || !root) return
+      const element = virtualContent?.querySelector<HTMLElement>(`[data-timeline-key="${CSS.escape(key)}"]`)
+      if (!element) virtualizer.scrollToIndex(index, { align: "start" })
+      else {
+        const line = root.getBoundingClientRect().top + topOffset()
+        const delta = element.getBoundingClientRect().top - (line - offset)
+        if (Math.abs(delta) > 1) {
+          root.scrollTop += delta
+          stable = 0
+        } else stable++
+      }
+      if (stable < 3 && ++frames < 60) requestAnimationFrame(refine)
+    }
+    requestAnimationFrame(refine)
+    return true
+  }
+
