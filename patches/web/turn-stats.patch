@@ -104,6 +104,34 @@ export function createSessionTimelineRowRenderer(input: {
     if (completed === undefined || completed < user.time.created) return undefined
     return completed - user.time.created
   }
+  // ocelot: cost and cache hit rate, summed over every step of the turn.
+  const stats = (messageID: string) => {
+    const messages = input.projection.assistantMessagesByParent().get(messageID) ?? emptyAssistantMessages
+    let cost = 0
+    let prompt = 0
+    let cached = 0
+    for (const message of messages) {
+      const tokens = message.tokens
+      cost += message.cost ?? 0
+      if (!tokens) continue
+      prompt += tokens.input + tokens.cache.read + tokens.cache.write
+      cached += tokens.cache.read
+    }
+    // Time to first token and generation speed come from the last model call that produced output.
+    const last = messages.findLast((message) => message.time.output !== undefined && !!message.tokens)
+    const output = last?.time.output
+    const end = last?.time.streamed ?? last?.time.completed
+    const generated = last?.tokens ? last.tokens.output + last.tokens.reasoning : 0
+    // Providers sometimes deliver a short reply in one burst (97 tokens in 3ms), so a
+    // window under a second says nothing about speed; leave t/s out then.
+    const window = output !== undefined && end !== undefined ? end - output : 0
+    return {
+      cost,
+      cacheHit: prompt > 0 ? cached / prompt : undefined,
+      ttft: last && output !== undefined ? output - last.time.created : undefined,
+      tps: window >= 1000 && generated > 0 ? generated / (window / 1000) : undefined,
+    }
+  }
   const copyContentID = (messageID: string) => {
     if (workingTurn(messageID)) return null
     const message = input.projection
@@ -276,6 +304,7 @@ export function createSessionTimelineRowRenderer(input: {
