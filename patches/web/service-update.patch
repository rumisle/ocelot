+})
diff --git a/packages/gui-extensions/src/ocelot-update/renderer.tsx b/packages/gui-extensions/src/ocelot-update/renderer.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..1580f1f76face364060def5fb0cf42e165ff3e35
--- /dev/null
+++ b/packages/gui-extensions/src/ocelot-update/renderer.tsx
@@ -0,0 +1,91 @@
+import { createSignal } from "solid-js"
+import { Native, Status, type Setup } from "../sdk"
+
+type State =
+  | { readonly status: "off" }
+  | { readonly status: "current" }
+  | { readonly status: "restart" | "reload"; readonly version: string }
+  | { readonly status: "installing"; readonly version: string }
+
+/**
+ * A server that restarts into a new binary once idle (`ocelot service set restart idle`) reports it
+ * through `/api/ocelot/restart`; the pill restarts it now and reloads into the new UI. After a restart
+ * the page itself is stale, and the pill reloads it. Only the web app served by that server shows it:
+ * requests are same-origin and use the session cookie, and anything else answers no restart route.
+ */
+const setup: Setup = (ctx) => {
+  if (ctx.use(Native) || !import.meta.env.PROD) return
+  const [state, setState] = createSignal<State>({ status: "current" })
+  // The server version that served this page, i.e. the version of the UI it runs.
+  let loaded: string | undefined
+
+  const read = async (path: string) => {
+    const response = await fetch(path, { credentials: "same-origin", headers: { accept: "application/json" } })
+    if (!response.ok) return undefined
+    return (await response.json()) as Record<string, unknown>
+  }
+  const server = async () => {
+    const info = await read("/api/info")
+    const data = (info?.data ?? info) as { version?: unknown; pid?: unknown } | undefined
+    return typeof data?.version === "string" ? { version: data.version, pid: data.pid } : undefined
+  }
+
+  const check = async () => {
+    const current = state()
+    if (current.status === "installing" || current.status === "off") return
+    const next = await (async (): Promise<State> => {
+      const info = await server()
+      if (info === undefined) return current
+      loaded ??= info.version
+      if (info.version !== loaded) return { status: "reload", version: info.version }
+      const restart = await read("/api/ocelot/restart")
+      if (restart === undefined) return { status: "off" }
+      if (restart.pending === true)
+        return { status: "restart", version: typeof restart.version === "string" ? restart.version : info.version }
+      return { status: "current" }
+    })().catch(() => current)
+    setState(next)
+  }
+
+  const install = async () => {
+    const current = state()
+    if (current.status === "reload") return location.reload()
+    if (current.status !== "restart") return
+    const before = await server()
+    setState({ status: "installing", version: current.version })
+    await fetch("/api/ocelot/restart", { method: "POST", credentials: "same-origin" }).catch(() => undefined)
+    // Reload once a new server process answers (or after two minutes regardless).
+    const deadline = Date.now() + 120_000
+    while (Date.now() < deadline) {
+      await new Promise((resolve) => setTimeout(resolve, 1_000))
+      const after = await server().catch(() => undefined)
+      if (after !== undefined && (after.pid !== before?.pid || after.version !== before?.version)) break
+    }
+    location.reload()
+  }
+
+  void check()
+  const timer = setInterval(() => void check(), 30_000)
+  const visible = () => {
+    if (document.visibilityState === "visible") void check()
+  }
+  document.addEventListener("visibilitychange", visible)
+  ctx.cleanup(() => {
+    clearInterval(timer)
+    document.removeEventListener("visibilitychange", visible)
+  })
+
+  ctx.add(Status, () => {
+    const current = state()
+    if (current.status !== "restart" && current.status !== "reload" && current.status !== "installing") return
+    return {
+      id: "update",
+      label: ctx.t("status.label"),
+      title: ctx.t(current.status === "reload" ? "status.reload" : "status.restart", { version: current.version }),
+      busy: current.status === "installing",
+      run: () => void install(),
+    }
+  })
+}
+
+export default setup
