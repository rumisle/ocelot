+/** ocelot: how long the agent has been working on the current run, like pi's working timer. */
+function ComposerWorkingTimer(props: { since?: number }) {
+  const [now, setNow] = createSignal(Date.now())
+  createEffect(() => {
+    if (props.since === undefined) return
+    setNow(Date.now())
+    const timer = setInterval(() => setNow(Date.now()), 1000)
+    onCleanup(() => clearInterval(timer))
+  })
+  const elapsed = (since: number) => {
+    const total = Math.max(0, Math.floor((now() - since) / 1000))
+    const hours = Math.floor(total / 3600)
+    const minutes = Math.floor((total % 3600) / 60)
+    const seconds = total % 60
+    if (hours) return `${hours}h ${String(minutes).padStart(2, "0")}m`
+    if (minutes) return `${minutes}m ${String(seconds).padStart(2, "0")}s`
+    return `${seconds}s`
+  }
+  return (
+    <Show when={props.since}>
+      {(since) => (
+        <span
+          data-slot="composer-working-timer"
+          role="timer"
+          aria-label="Working"
+          class="me-2 text-[12px] leading-4 tabular-nums text-v2-text-text-faint"
+        >
+          {elapsed(since())}
+        </span>
+      )}
+    </Show>
+  )
+}
