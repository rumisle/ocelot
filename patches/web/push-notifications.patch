+      // ocelot: Web Push handlers (public/ocelot-push-sw.js). The server caches it for a year,
+      // so its URL carries its hash.
+      importScripts: [`/ocelot-push-sw.js?v=${pushWorkerHash()}`],
       navigateFallback: "/index.html",
       // Pairing links must reach the server so it can set the session cookie.
       navigateFallbackDenylist: [/^\/(?:api|auth)(?:\/|$)/, /^\/(?:_assets|assets)(?:\/|$)/],
@@ -42,3 +46,8 @@ export function serviceWorker(directory: string) {
     },
   })
 }
+
+function pushWorkerHash() {
+  const source = readFileSync(new URL("./public/ocelot-push-sw.js", import.meta.url))
+  return createHash("sha256").update(source).digest("hex").slice(0, 12)
+}
