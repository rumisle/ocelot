@@ -0,0 +1,81 @@
+import { Component, Show, onMount } from "solid-js"
+import { createStore } from "solid-js/store"
+import { Button } from "@opencode/ui/button"
+import { Switch } from "@opencode/ui/switch"
+import { useLanguage } from "@/runtime/i18n/language"
+import { useSettings } from "@/settings/model"
+import { SettingsList } from "@/settings/list"
+import { SettingsRow } from "@/settings/row"
+import { Push, type PushStatus } from "@/shell/notifications/push"
+
+// ocelot: push to this device (see shell/notifications/push.ts).
+export const SettingsPush: Component = () => {
+  const language = useLanguage()
+  const settings = useSettings()
+  const [state, setState] = createStore({
+    on: false,
+    busy: false,
+    denied: false,
+    status: undefined as PushStatus | undefined,
+    error: undefined as string | undefined,
+  })
+
+  const run = async (task: () => Promise<PushStatus | undefined>) => {
+    setState({ busy: true, error: undefined })
+    const status = await task().catch((error: unknown) => {
+      setState("error", error instanceof Error ? error.message : String(error))
+      return undefined
+    })
+    setState({ busy: false, on: Push.enabled(), status, denied: Notification.permission === "denied" })
+  }
+
+  onMount(() => {
+    if (Push.supported()) void run(() => Push.sync(Push.kinds(settings.notifications)))
+  })
+
+  const toggle = (checked: boolean) =>
+    void run(async () => {
+      if (!checked) return Push.disable().then(() => undefined)
+      return Push.enable(Push.kinds(settings.notifications))
+    })
+
+  const description = () => {
+    if (!Push.supported()) return language.t("settings.notifications.push.unsupported")
+    if (state.denied) return language.t("settings.notifications.push.denied")
+    if (state.error) return language.t("settings.notifications.push.error", { error: state.error })
+    if (!state.on) return language.t("settings.notifications.push.description")
+    if (state.status?.failed) return language.t("settings.notifications.push.failed", { error: state.status.failed })
+    if (state.status?.delivered)
+      return language.t("settings.notifications.push.delivered", {
+        time: new Date(state.status.delivered).toLocaleString(),
+      })
+    return language.t("settings.notifications.push.waiting")
+  }
+
+  return (
+    <div class="settings-section">
+      <h3 class="settings-section-title">{language.t("settings.notifications.push.section")}</h3>
+      <SettingsList>
+        <SettingsRow title={language.t("settings.notifications.push.title")} description={description()}>
+          <div data-action="settings-notifications-push">
+            <Switch
+              checked={state.on}
+              disabled={!Push.supported() || state.busy}
+              onChange={(checked) => toggle(checked)}
+            />
+          </div>
+        </SettingsRow>
+        <Show when={state.on}>
+          <SettingsRow
+            title={language.t("settings.notifications.push.test.title")}
+            description={language.t("settings.notifications.push.test.description")}
+          >
+            <Button variant="neutral" disabled={state.busy} onClick={() => void run(() => Push.test())}>
+              {language.t("settings.notifications.push.test.action")}
+            </Button>
+          </SettingsRow>
+        </Show>
+      </SettingsList>
+    </div>
+  )
+}
