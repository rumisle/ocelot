From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rumisle <why-excuse-quail@duck.com>
Date: Sat, 3 Oct 2026 01:48:20 +0800
Subject: app: push notifications to this device; notify for permissions and
 questions

Settings > Notifications gets "Push to this device" (with the last
delivery or failure, and a test button). The three notification switches
choose what is pushed. The service worker (public/ocelot-push-sw.js,
imported by the generated one) shows every push, one per session, and a
tap opens the session: in an open window, or a new one. Opening a session
closes its notifications on this device. Every page reports whether it
is in use, so the server holds pushes back while you are at one. On a
device with push on, the page's own system notifications are skipped:
the push covers them.

The Permissions switch and sound now also apply: a permission request or
a question in a session with an open tab notifies like a finished turn.

Ocelot-Patch: web/push-notifications

diff --git a/packages/app/public/ocelot-push-sw.js b/packages/app/public/ocelot-push-sw.js
new file mode 100644
index 0000000000000000000000000000000000000000..1d4617b62043a074d6eb5665b4cfeceb50147eec
--- /dev/null
+++ b/packages/app/public/ocelot-push-sw.js
@@ -0,0 +1,36 @@
+// ocelot: Web Push (packages/cli/src/services/web-push.ts), imported by the generated service worker.
+
+self.addEventListener("push", (event) => {
+  const data = (() => {
+    try {
+      return event.data?.json() ?? {}
+    } catch {
+      return {}
+    }
+  })()
+  // Always show something: iOS revokes a subscription whose pushes show nothing.
+  event.waitUntil(
+    self.registration.showNotification(data.title || "OpenCode", {
+      body: data.body ?? "",
+      icon: "/web-app-manifest-192x192.png",
+      // One notification per session: a newer one replaces it.
+      tag: data.session,
+      renotify: typeof data.session === "string",
+      data: { session: data.session, url: data.url },
+    }),
+  )
+})
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close()
+  const data = event.notification.data ?? {}
+  event.waitUntil(
+    (async () => {
+      const windows = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
+      const client = windows.find((item) => item.visibilityState === "visible") ?? windows[0]
+      if (client === undefined) return self.clients.openWindow(data.url || "/")
+      await client.focus().catch(() => undefined)
+      if (typeof data.session === "string") client.postMessage({ type: "ocelot.push.open", session: data.session })
+    })(),
+  )
+})
