diff --git a/packages/app/src/shell/notifications/push.ts b/packages/app/src/shell/notifications/push.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ba892443fd8067ae35f98594a88ddbeaa58c1462
--- /dev/null
+++ b/packages/app/src/shell/notifications/push.ts
@@ -0,0 +1,179 @@
+import { createSignal } from "solid-js"
+import { ServerConnection } from "@/runtime/server/registry"
+import { sessionHref } from "@/shell/routes/session"
+
+// ocelot: Web Push through the server that serves this page (packages/cli/src/services/web-push.ts).
+// The page's service worker shows the pushes (public/ocelot-push-sw.js). Every open page also reports
+// whether it is in use, so nothing is pushed while you are at one.
+
+export type PushKind = "done" | "permission" | "error"
+export type PushStatus = { readonly subscribed: boolean; readonly delivered?: number; readonly failed?: string }
+
+const API = "/api/ocelot/push"
+/** A focused page counts as in use until this long after the last input. */
+const IDLE = 3 * 60_000
+const HEARTBEAT = 20_000
+
+const [enabled, setEnabled] = createSignal(false)
+
+export const Push = {
+  /** Whether this browser can receive pushes from this page's server (an installed app on iOS). */
+  supported() {
+    return (
+      import.meta.env.PROD &&
+      typeof window !== "undefined" &&
+      "serviceWorker" in navigator &&
+      "PushManager" in window &&
+      "Notification" in window
+    )
+  },
+  /** This device has a push subscription; local system notifications would duplicate it. */
+  enabled,
+  /** What this device is pushed, from its notification settings. */
+  kinds(notifications: { agent(): boolean; permissions(): boolean; errors(): boolean }) {
+    const kinds: PushKind[] = []
+    if (notifications.agent()) kinds.push("done")
+    if (notifications.permissions()) kinds.push("permission")
+    if (notifications.errors()) kinds.push("error")
+    return kinds
+  },
+  /** The server this page talks to for pushes. */
+  origin(key: ServerConnection.Key) {
+    return typeof location !== "undefined" && key === location.origin
+  },
+  async subscription() {
+    if (!Push.supported()) return null
+    const registration = await navigator.serviceWorker.getRegistration()
+    const subscription = (await registration?.pushManager.getSubscription()) ?? null
+    setEnabled(subscription !== null)
+    return subscription
+  },
+  /** Must run from a user gesture: iOS only asks for permission then. */
+  async enable(kinds: PushKind[]) {
+    const permission = await Notification.requestPermission()
+    if (permission !== "granted") return { subscribed: false, failed: permission } satisfies PushStatus
+    const key = await request<{ publicKey: string }>("GET", "")
+    const registration = await navigator.serviceWorker.ready
+    const subscription = await registration.pushManager.subscribe({
+      userVisibleOnly: true,
+      applicationServerKey: decode(key.publicKey),
+    })
+    setEnabled(true)
+    return register(subscription, kinds)
+  },
+  async disable() {
+    const subscription = await Push.subscription()
+    if (subscription === null) return
+    await request("DELETE", "/subscription", { endpoint: subscription.endpoint }).catch(() => undefined)
+    await subscription.unsubscribe()
+    setEnabled(false)
+  },
+  /** Re-registers this device (with its current kinds): repairs a server that forgot it, and reads its status. */
+  async sync(kinds: PushKind[]) {
+    const subscription = await Push.subscription()
+    if (subscription === null) return undefined
+    return register(subscription, kinds)
+  },
+  async test() {
+    const subscription = await Push.subscription()
+    if (subscription === null) return undefined
+    return request<PushStatus>("POST", "/test", { endpoint: subscription.endpoint })
+  },
+  /** Closes this device's notifications for a session you are now looking at. */
+  dismiss(sessionID: string) {
+    if (!Push.supported()) return
+    void navigator.serviceWorker
+      .getRegistration()
+      .then((registration) => registration?.getNotifications({ tag: sessionID }))
+      .then((notifications) => notifications?.forEach((notification) => notification.close()))
+      .catch(() => undefined)
+  },
+  /** Reports whether this page is in use: visible, focused and touched within IDLE. Returns a cleanup. */
+  presence() {
+    const client = crypto.randomUUID()
+    const state = { input: Date.now(), sent: undefined as boolean | undefined, stopped: false }
+    const inUse = () => document.visibilityState === "visible" && document.hasFocus() && Date.now() - state.input < IDLE
+    const send = (active: boolean, force = false) => {
+      if (state.stopped || (!force && state.sent === active && !active)) return
+      state.sent = active
+      void fetch(`${API}/presence`, {
+        method: "POST",
+        credentials: "same-origin",
+        keepalive: true,
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ client, active }),
+      })
+        .then((response) => {
+          // Not an ocelot server: nothing to report to.
+          if (response.status === 404) stop()
+        })
+        .catch(() => undefined)
+    }
+    const update = () => send(inUse())
+    const input = () => {
+      const idle = Date.now() - state.input >= IDLE
+      state.input = Date.now()
+      if (idle) update()
+    }
+    const leave = () => send(false, true)
+    const timer = setInterval(update, HEARTBEAT)
+    const inputs = ["pointerdown", "pointermove", "keydown", "wheel", "touchstart"] as const
+    inputs.forEach((name) => window.addEventListener(name, input, { passive: true }))
+    window.addEventListener("focus", update)
+    window.addEventListener("blur", update)
+    window.addEventListener("pagehide", leave)
+    document.addEventListener("visibilitychange", update)
+    const stop = () => {
+      state.stopped = true
+      clearInterval(timer)
+      inputs.forEach((name) => window.removeEventListener(name, input))
+      window.removeEventListener("focus", update)
+      window.removeEventListener("blur", update)
+      window.removeEventListener("pagehide", leave)
+      document.removeEventListener("visibilitychange", update)
+    }
+    update()
+    return () => {
+      leave()
+      stop()
+    }
+  },
+  /** Opens sessions for notifications tapped while a page was already open. Returns a cleanup. */
+  onOpen(open: (sessionID: string) => void) {
+    if (!Push.supported()) return () => undefined
+    const listener = (event: MessageEvent) => {
+      const data: unknown = event.data
+      if (typeof data !== "object" || data === null) return
+      if (!("type" in data) || data.type !== "ocelot.push.open") return
+      if ("session" in data && typeof data.session === "string") open(data.session)
+    }
+    navigator.serviceWorker.addEventListener("message", listener)
+    navigator.serviceWorker.startMessages()
+    return () => navigator.serviceWorker.removeEventListener("message", listener)
+  },
+}
+
+function register(subscription: PushSubscription, kinds: PushKind[]) {
+  const json = subscription.toJSON()
+  return request<PushStatus>("PUT", "/subscription", {
+    subscription: { endpoint: subscription.endpoint, keys: json.keys },
+    kinds,
+    href: sessionHref(ServerConnection.Key.make(location.origin), ""),
+  })
+}
+
+async function request<T>(method: string, path: string, body?: unknown): Promise<T> {
+  const response = await fetch(API + path, {
+    method,
+    credentials: "same-origin",
+    headers: body === undefined ? { accept: "application/json" } : { "content-type": "application/json" },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  })
+  if (!response.ok) throw new Error(`${method} ${API}${path}: ${response.status}`)
+  return response.json() as Promise<T>
+}
+
+function decode(value: string) {
+  const base64 = value.replace(/-/g, "+").replace(/_/g, "/")
+  return Uint8Array.from(atob(base64 + "=".repeat((4 - (base64.length % 4)) % 4)), (char) => char.charCodeAt(0))
+}
