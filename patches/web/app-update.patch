diff --git a/packages/app/src/shell/notifications/update.ts b/packages/app/src/shell/notifications/update.ts
new file mode 100644
index 0000000000000000000000000000000000000000..56ee78bdcd2a765022de3138ba4b0c8782a76bf7
--- /dev/null
+++ b/packages/app/src/shell/notifications/update.ts
@@ -0,0 +1,73 @@
+import { onCleanup } from "solid-js"
+import { useLanguage } from "@/runtime/i18n/language"
+import { showToast } from "@/shell/notifications/toast"
+
+// ocelot: a new build waits until every page of the old one closes (skipWaiting: false), and an
+// installed app on iOS is suspended rather than closed, so it never updated. Check again whenever
+// the app comes back, and offer a reload once the new build is installed.
+
+const CHECK_EVERY = 60_000
+
+export function useAppUpdate() {
+  if (!import.meta.env.PROD || typeof window === "undefined" || !("serviceWorker" in navigator)) return
+  const language = useLanguage()
+  let disposed = false
+  let checked = 0
+  let offered: ServiceWorker | undefined
+  let reloading = false
+
+  const offer = (worker: ServiceWorker) => {
+    // A first install has no page to replace.
+    if (disposed || offered === worker || !navigator.serviceWorker.controller) return
+    offered = worker
+    showToast({
+      title: language.t("app.update.title"),
+      persistent: true,
+      actions: [
+        {
+          label: language.t("app.update.reload"),
+          onClick: () => worker.postMessage({ type: "SKIP_WAITING" }),
+        },
+        { label: language.t("common.dismiss"), onClick: "dismiss" },
+      ],
+    })
+  }
+
+  const watch = (registration: ServiceWorkerRegistration) => {
+    if (registration.waiting) offer(registration.waiting)
+    registration.addEventListener("updatefound", () => {
+      const worker = registration.installing
+      worker?.addEventListener("statechange", () => {
+        if (worker.state === "installed") offer(worker)
+      })
+    })
+  }
+
+  const check = () => {
+    if (document.visibilityState !== "visible" || Date.now() - checked < CHECK_EVERY) return
+    checked = Date.now()
+    void navigator.serviceWorker.getRegistration().then((registration) => registration?.update().catch(() => {}))
+  }
+
+  // Every page of the old build reloads once the new one takes over, so none of them asks
+  // for chunks the new cache no longer has.
+  const onControllerChange = () => {
+    if (reloading || !offered) return
+    reloading = true
+    location.reload()
+  }
+
+  void navigator.serviceWorker.ready.then((registration) => {
+    if (!disposed) watch(registration)
+  })
+  checked = Date.now()
+  navigator.serviceWorker.addEventListener("controllerchange", onControllerChange)
+  document.addEventListener("visibilitychange", check)
+  window.addEventListener("focus", check)
+  onCleanup(() => {
+    disposed = true
+    navigator.serviceWorker.removeEventListener("controllerchange", onControllerChange)
+    document.removeEventListener("visibilitychange", check)
+    window.removeEventListener("focus", check)
+  })
+}
