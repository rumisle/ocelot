From: rumisle <why-excuse-quail@duck.com>
Date: Sun, 27 Sep 2026 12:09:21 +0800
Subject: app/session: the page title is the session's title
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The browser tab said "OpenCode" everywhere. A session page now sets it to
"<session title> · OpenCode", follows renames (including the automatic title), and goes
back to "OpenCode" when you leave the session.

Ocelot-Patch: web/page-title

diff --git a/packages/app/src/session/screen.tsx b/packages/app/src/session/screen.tsx
index bc5e145331f1ae244da63bc1a55a2fe068c70936..5d2a1d3ef6efe385a0f945a70c6804c739dd48aa 100644
--- a/packages/app/src/session/screen.tsx
+++ b/packages/app/src/session/screen.tsx
@@ -25,6 +25,7 @@ import { SessionIdentityHeader } from "./session-identity-header"
 import { SessionReviewToggle } from "./header/session-header-actions"
 import { createAnimatedPresence } from "@/runtime/animated-presence"
 import { createTimelineCache } from "./timeline/cache"
+import { sessionTitle } from "./title"
 
 export function SessionScreen(props: { session: SessionModel }) {
   // The timeline cache captures its owner when created, so link handling must be provided above it.
@@ -44,6 +45,14 @@ function SessionScreenContent(props: {
   const session = props.session
   const host = useExtensionHost()
   const attachment = useExtensionAttachment()
+  // ocelot: the page (browser tab) title is the session's title.
+  createEffect(() => {
+    const title = sessionTitle(session.data.info()?.title)
+    document.title = title ? `${title} · OpenCode` : "OpenCode"
+  })
+  onCleanup(() => {
+    document.title = "OpenCode"
+  })
   const isDesktop = session.isDesktop
   const sidebar = createPanelSidebar()
   const region = createRegion({ region: "side", view: props.view, tabs: session.layout.tabs })
