new file mode 100644
index 0000000000000000000000000000000000000000..ea264a5aea921b2a985e65a1f207e782bda21b66
--- /dev/null
+++ b/packages/gui-extensions/src/usage/context-figures.test.ts
@@ -0,0 +1,47 @@
+import { describe, expect, test } from "bun:test"
+import type { ConfigEntry } from "@opencode/client/promise"
+import { compactionThreshold, formatTokens } from "./context-figures"
+
+const doc = (compaction: object) => ({ type: "document", info: { compaction } }) as unknown as ConfigEntry
+
+describe("formatTokens", () => {
+  test("shortens like pi", () => {
+    expect([950, 8086, 340_412, 1_000_000, 1_234_567, 12_000_000].map(formatTokens)).toEqual([
+      "950",
+      "8.1k",
+      "340k",
+      "1.0M",
+      "1.2M",
+      "12M",
+    ])
+  })
+})
+
+describe("compactionThreshold", () => {
+  const million = { context: 1_000_000 }
+  test("summary strategy keeps 10% free", () => {
+    expect(compactionThreshold(million, [])).toBe(900_000)
+    expect(compactionThreshold({ context: 200_000 }, [])).toBe(180_000)
+  })
+  test("a buffer replaces the 10%", () => {
+    expect(compactionThreshold(million, [doc({ buffer: 50_000 })])).toBe(950_000)
+  })
+  test("checkpoint caps at 540k and 90%", () => {
+    expect(compactionThreshold(million, [doc({ strategy: "checkpoint" })])).toBe(540_000)
+    expect(compactionThreshold({ context: 200_000 }, [doc({ strategy: "checkpoint" })])).toBe(180_000)
+  })
+  test("fields merge across documents, later wins", () => {
+    const entries = [doc({ strategy: "checkpoint" }), doc({ threshold: { tokens: 300_000 } })]
+    expect(compactionThreshold(million, entries)).toBe(300_000)
+  })
+  test("native compaction ignores the checkpoint caps", () => {
+    expect(compactionThreshold(million, [doc({ strategy: "checkpoint" })], true)).toBe(900_000)
+  })
+  test("off or unknown window: none", () => {
+    expect(compactionThreshold(million, [doc({ auto: false })])).toBeUndefined()
+    expect(compactionThreshold({ context: 0 }, [])).toBeUndefined()
+  })
+  test("the input limit wins over the context window", () => {
+    expect(compactionThreshold({ context: 1_000_000, input: 272_000 }, [])).toBe(244_800)
+  })
+})
diff --git a/packages/gui-extensions/src/usage/context-figures.ts b/packages/gui-extensions/src/usage/context-figures.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7f05850d28469334ef32e7ccf767f3efb074673c
--- /dev/null
+++ b/packages/gui-extensions/src/usage/context-figures.ts
@@ -0,0 +1,53 @@
+import type { ConfigEntry } from "@opencode/client/promise"
+
+/** Token counts the way pi's footer shows them: 950, 8.1k, 340k, 1.2M, 12M. */
+export function formatTokens(count: number): string {
+  if (count < 1000) return count.toString()
+  if (count < 10000) return `${(count / 1000).toFixed(1)}k`
+  if (count < 1000000) return `${Math.round(count / 1000)}k`
+  if (count < 10000000) return `${(count / 1000000).toFixed(1)}M`
+  return `${Math.round(count / 1000000)}M`
+}
+
+// Mirrors core/src/session/compaction.ts (calculateCeiling, checkpointCeiling) and the per-field merge in
+// core/src/config/plugin/compaction.ts. Keep them in step.
+const RESERVE_MIN = 16_000
+const CHECKPOINT_RATIO = 0.9
+const CHECKPOINT_MAX = 540_000
+
+type Settings = { auto?: boolean; buffer?: number; strategy?: "summary" | "checkpoint"; ratio?: number; max?: number }
+
+function settings(entries: readonly ConfigEntry[]): Settings {
+  const result: Settings = {}
+  for (const entry of entries) {
+    if (entry.type !== "document" || !entry.info.compaction) continue
+    const compaction = entry.info.compaction
+    if (compaction.auto !== undefined) result.auto = compaction.auto
+    if (compaction.buffer !== undefined) result.buffer = compaction.buffer
+    if (compaction.strategy !== undefined) result.strategy = compaction.strategy
+    if (compaction.threshold?.ratio !== undefined) result.ratio = compaction.threshold.ratio
+    if (compaction.threshold?.tokens !== undefined) result.max = compaction.threshold.tokens
+  }
+  return result
+}
+
+/**
+ * When automatic compaction starts for a model with these limits, in tokens. `undefined` when it never does
+ * on its own (turned off, or the window is unknown).
+ */
+export function compactionThreshold(
+  limit: { context: number; input?: number },
+  entries: readonly ConfigEntry[],
+  native = false,
+): number | undefined {
+  const config = settings(entries)
+  if (config.auto === false) return undefined
+  const window = limit.input || limit.context
+  if (window <= 0) return undefined
+  const ceiling =
+    config.buffer !== undefined
+      ? window - config.buffer
+      : window - Math.max(Math.floor(window * 0.1), window >= 2 * RESERVE_MIN ? RESERVE_MIN : 0)
+  if (config.strategy !== "checkpoint" || native) return ceiling
+  return Math.min(ceiling, Math.floor(window * (config.ratio ?? CHECKPOINT_RATIO)), config.max ?? CHECKPOINT_MAX)
+}
