@@ -5,6 +5,23 @@ type Entry = { method: string; url: string; at: number; slow: boolean; urgent?:
 // a burst stalls probes and user actions inside the browser where nothing can observe it.
 export const requestQueueLimit = 4
 
+// ocelot: over HTTP/2 or HTTP/3 every request shares one connection, so the six-connection budget
+// above does not apply; on a slow link four at a time turned a reconnect's few hundred small reads
+// into a minute of queueing. Still bounded, so a burst does not swamp the server.
+export const multiplexedRequestQueueLimit = 16
+
+// The page's own protocol; API requests to the page's origin travel the same way.
+function multiplexed(url: string) {
+  try {
+    if (typeof location === "undefined" || typeof performance === "undefined") return false
+    if (new URL(url).origin !== location.origin) return false
+    const navigation = performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming | undefined
+    return /^h[23]/.test(navigation?.nextHopProtocol ?? "")
+  } catch {
+    return false
+  }
+}
+
 // Endpoints that shell out to git or walk the filesystem take seconds on a large repository. They
 // may hold at most this many slots, so a session mount's small reads never queue behind them.
 export const requestQueueSlowLimit = 2
@@ -29,6 +46,9 @@ export const setupRequestHeadersTimeoutMs = 10 * 60_000
 const urgentRequestPath = /^\/api\/session\/[^/]+\/(message|message-sync|message\/[^/]+)$/
 
 export function isUrgentRequest(method: string, pathname: string) {
+  // ocelot: so does anything that is not a read (sending a prompt, answering a permission,
+  // stopping a run): behind a reconnect's catalog re-sync it waited a minute on a slow link.
+  if (method !== "GET" && method !== "HEAD") return true
   return method === "GET" && urgentRequestPath.test(pathname)
 }
 
