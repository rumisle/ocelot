+// The subagent card, shared with Code Mode calls that drive child sessions (ocelot).
+// Spins while the call or the child session runs; opens the child session's live transcript.
+function ChildSessionCard(props: {
+  sessionID: string | undefined
+  status?: string
+  title: string
+  subtitle?: string
+  tone?: string
+  v2Tone?: string
+  /** Show the title as written instead of capitalized (worker names). */
+  literal?: boolean
+}) {
+  const data = useData()
+  const running = createMemo(() => {
+    if (props.status === "streaming" || props.status === "running") return true
+    const id = props.sessionID
+    if (!id) return false
+    return (data.store.session_status[id]?.type ?? "idle") !== "idle"
+  })
+
+  const href = createMemo(() => sessionLink(props.sessionID, data.sessionHref))
+  const clickable = createMemo(() => !!(props.sessionID && (data.navigateToSession || href())))
+
+  const open = () => {
+    const id = props.sessionID
+    if (!id) return
+    data.navigateToSession?.(id)
+  }
+
+  const navigate = (event: MouseEvent) => {
+    if (!data.navigateToSession) return
+    if (event.button !== 0 || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return
+    event.preventDefault()
+    open()
+  }
+  const navigateKey = (event: KeyboardEvent) => {
+    if (!clickable() || href()) return
+    if (event.key !== "Enter" && event.key !== " ") return
+    event.preventDefault()
+    open()
+  }
+
+  const trigger = () => (
+    <div
+      data-component="task-tool-card"
+      style={{
+        "--task-agent-color": props.v2Tone,
+        "--task-agent-color-fallback": props.tone,
+      }}
+    >
+      <div data-component="task-tool-surface">
+        <div data-slot="basic-tool-tool-info-structured">
+          <div data-slot="basic-tool-tool-info-main">
+            <Show
+              when={running()}
+              fallback={
+                <span data-component="task-tool-icon">
+                  <Icon name="subagent" size="small" />
+                </span>
+              }
+            >
+              <span data-component="task-tool-spinner" style={{ color: props.tone ?? "var(--icon-interactive-base)" }}>
+                <SessionProgressIndicatorV2
+                  style={{ color: props.v2Tone ?? "light-dark(var(--v2-text-text-base), #ffffff)" }}
+                />
+              </span>
+            </Show>
+            <span data-component="task-tool-title" data-literal={props.literal ? "" : undefined}>
+              {props.title}
+            </span>
+            <Show when={props.subtitle}>
+              <span data-slot="basic-tool-tool-subtitle">{props.subtitle}</span>
+            </Show>
+          </div>
+          <Show when={clickable()}>
+            <div data-component="task-tool-action">
+              <Icon name="chevron-right" size="normal" />
+            </div>
+          </Show>
+        </div>
+      </div>
+    </div>
+  )
+
+  return (
+    <BasicTool
+      icon="task"
+      status={props.status}
+      trigger={trigger()}
+      hideDetails
+      triggerAsLink
+      triggerHref={href()}
+      clickable={clickable()}
+      onTriggerClick={navigate}
+      onTriggerKeyDown={navigateKey}
+    />
+  )
+}
+
+/**
+ * Child sessions a Code Mode run started or drove, in first-seen order (ocelot): each nested
+ * call whose metadata named a sessionID gets it recorded on its row (core codemode patch).
+ * Titles like "name · task" (octopi workers) split into the card's title and subtitle.
+ */
+function executeChildSessions(metadata: Record<string, unknown>, sessions: SessionSummary[] | undefined) {
+  const calls = Array.isArray(metadata.toolCalls) ? metadata.toolCalls : []
+  const seen = new Map<string, string | undefined>()
+  for (const call of calls) {
+    if (!call || typeof call !== "object") continue
+    const ids = (call as { sessionIDs?: unknown }).sessionIDs
+    if (!Array.isArray(ids)) continue
+    const input = (call as { input?: Record<string, unknown> }).input
+    const name = typeof input?.name === "string" ? input.name : undefined
+    for (const id of ids) if (typeof id === "string" && !seen.has(id)) seen.set(id, name)
+  }
+  return [...seen].map(([id, name]) => {
+    const title = sessions?.find((session) => session.id === id)?.title ?? name ?? id
+    const [head, ...rest] = title.split(" · ")
+    return { id, title: head, subtitle: rest.join(" · ") || undefined }
+  })
+}
