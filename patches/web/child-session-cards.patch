+
+/**
+ * ocelot: a Code Mode run whose nested calls drove child sessions (octopi workers). It shows a
+ * card per child session and is placed like a subagent call rather than a shell command.
+ */
+export function executeDrivesSessions(content: SessionMessageAssistant["content"][number]) {
+  if (content.type !== "tool" || content.name !== "execute") return false
+  const calls = currentToolMetadata(content).toolCalls
+  return (
+    Array.isArray(calls) &&
+    calls.some(
+      (call) =>
+        !!call &&
+        typeof call === "object" &&
+        Array.isArray((call as { sessionIDs?: unknown }).sessionIDs) &&
+        (call as { sessionIDs: unknown[] }).sessionIDs.length > 0,
+    )
+  )
+}
