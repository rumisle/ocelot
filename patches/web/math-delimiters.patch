+test("renders the math forms models write", async () => {
+  const inline = (html: string) => (html.match(/<span class="katex">/g) ?? []).length
+  const display = (html: string) => (html.match(/<span class="katex-display">/g) ?? []).length
+  expect(inline(await parser.parse("Then $I(0) = 0$ and $x$."))).toBe(2)
+  expect(display(await parser.parse("$$I = \\int_0^1 f(x)\\,dx$$\n"))).toBe(1)
+  expect(display(await parser.parse("Define $$I(a) = a$$ here."))).toBe(1)
+  expect(display(await parser.parse("\\[\nx^2\n\\]\n"))).toBe(1)
+  expect(display(await parser.parse("$$\nx^2 + y^2\n$$\n"))).toBe(1)
+})
+
+test.each(["It costs $5 and $10.", "Between $5-$6 per hour", "a $ b $ c", "\\$x$"])(
+  "leaves dollar amounts alone: %s",
+  async (text) => {
+    expect(await parser.parse(text)).not.toContain("katex")
+  },
+)
+
 test("uses the configured code highlighter", async () => {
