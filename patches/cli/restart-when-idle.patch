diff --git a/packages/cli/src/services/idle-restart.ts b/packages/cli/src/services/idle-restart.ts
new file mode 100644
index 000000000..1f487e230
--- /dev/null
+++ b/packages/cli/src/services/idle-restart.ts
@@ -0,0 +1,145 @@
+export * as IdleRestart from "./idle-restart"
+
+import { Service, type EnsureOptions } from "@opencode/client/effect/service"
+import { OpenCode } from "@opencode/client/promise"
+import { spawn } from "node:child_process"
+import { Effect, FileSystem, Option, Schedule, Schema } from "effect"
+import { selfCommand } from "../util/process"
+import { ServiceConfig } from "./service-config"
+
+// ocelot: restart the managed server once it is idle instead of in the middle of a turn.
+// A detached waiter (`service restart --idle-waiter`, spawned by `request`) polls the server's
+// running sessions and, after QUIET without any, replaces it the way a newer client does:
+// persistent terminals are handed over, and the new server is started from the binary on disk.
+// Its progress is `<registration>.restart`, which `service status` shows.
+
+export const QUIET = 30_000
+
+const Status = Schema.Struct({
+  waiter: Schema.Int,
+  server: Schema.Int,
+  running: Schema.Array(Schema.String),
+  idleSince: Schema.optional(Schema.Number),
+})
+type Status = typeof Status.Type
+
+const decodeStatus = Schema.decodeUnknownOption(Schema.fromJsonString(Status))
+const decodeRegistration = Schema.decodeUnknownOption(Schema.fromJsonString(Service.Info))
+
+/** Starts a waiter for the running server unless one is already waiting. Returns false when no server is running. */
+export const request = Effect.fnUntraced(function* (file: string) {
+  const server = yield* registration(file)
+  if (server === undefined) return false
+  if ((yield* status(file)) !== undefined) return true
+  const [command, ...args] = selfCommand()
+  spawn(command!, [...args, "service", "restart", "--idle-waiter"], { detached: true, stdio: "ignore" }).unref()
+  return true
+})
+
+/** The pending restart of the running server, if a waiter is alive. */
+export const status = Effect.fnUntraced(function* (file: string) {
+  const fs = yield* FileSystem.FileSystem
+  const found = Option.getOrUndefined(
+    decodeStatus(yield* fs.readFileString(file + ".restart").pipe(Effect.orElseSucceed(() => ""))),
+  )
+  if (found === undefined || !alive(found.waiter)) return undefined
+  if ((yield* registration(file))?.pid !== found.server) return undefined
+  return found
+})
+
+/** The waiter: runs until the server is replaced, by this waiter or anyone else. */
+export const wait = Effect.fnUntraced(function* (options: EnsureOptions & { readonly file: string }) {
+  const fs = yield* FileSystem.FileSystem
+  const statusFile = options.file + ".restart"
+  const server = yield* registration(options.file)
+  if (server === undefined) return
+  if ((yield* status(options.file)) !== undefined) return
+  const client = OpenCode.make({
+    baseUrl: server.url,
+    headers: Service.headers({
+      url: server.url,
+      auth: server.password === undefined ? undefined : { type: "basic", username: "opencode", password: server.password },
+    }),
+  })
+  const write = (value: Status) => fs.writeFileString(statusFile, JSON.stringify(value), { mode: 0o600 })
+  let idleSince: number | undefined
+  while ((yield* registration(options.file))?.pid === server.pid) {
+    // An unreachable server counts as busy: it may be starting a turn we can't see.
+    const running = yield* Effect.tryPromise(() => client.session.active({ signal: AbortSignal.timeout(5_000) })).pipe(
+      Effect.map(Object.keys),
+      Effect.orElseSucceed(() => undefined),
+    )
+    idleSince = running?.length === 0 ? (idleSince ?? Date.now()) : undefined
+    yield* write({ waiter: process.pid, server: server.pid, running: running ?? [], idleSince })
+    if (idleSince !== undefined && Date.now() - idleSince >= QUIET) {
+      yield* Effect.logInfo("restarting the idle server", { server: server.pid, version: server.version })
+      yield* Service.stop({ file: options.file, pty: "handoff" })
+      yield* Service.ensure({ ...options, version: undefined })
+      break
+    }
+    yield* Effect.sleep("2 seconds")
+  }
+  yield* fs.remove(statusFile).pipe(Effect.ignore)
+})
+
+/**
+ * For a client that would replace a server running another version: with `restart idle`, a busy
+ * server is left running and restarts once idle. Returns its endpoint to connect to meanwhile.
+ */
+export const defer = Effect.fnUntraced(function* (options: EnsureOptions & { readonly file: string }) {
+  if ((yield* ServiceConfig.read()).restart !== "idle") return undefined
+  if ((yield* Service.discover(options)) !== undefined) return undefined
+  const existing = yield* Service.discover({ ...options, version: undefined })
+  if (existing === undefined) return undefined
+  const client = OpenCode.make({ baseUrl: existing.url, headers: Service.headers(existing) })
+  const running = yield* Effect.tryPromise(() => client.session.active({ signal: AbortSignal.timeout(5_000) })).pipe(
+    Effect.map((active) => Object.keys(active).length),
+    Effect.orElseSucceed(() => 0),
+  )
+  if (running === 0) return undefined
+  yield* request(options.file)
+  process.stderr.write(
+    `Background server is busy (${running} running session${running === 1 ? "" : "s"}); it restarts into this version once idle.\n`,
+  )
+  return existing
+})
+
+/** In the server: with `restart idle`, a new binary at our own path restarts us once idle. */
+export const watch = Effect.fnUntraced(function* (file: string) {
+  const command = selfCommand()
+  // Only a compiled binary is replaced by an install; `bun run` would watch bun itself.
+  if (command.length !== 1) return
+  const stamp = () =>
+    Effect.promise(() =>
+      Bun.file(command[0]!)
+        .stat()
+        .then((stat) => `${stat.ino}:${stat.size}:${stat.mtimeMs}`)
+        .catch(() => undefined),
+    )
+  let last = yield* stamp()
+  yield* Effect.gen(function* () {
+    const next = yield* stamp()
+    // Missing means mid-install; wait for the new file.
+    if (next === undefined || next === last) return
+    last = next
+    if ((yield* ServiceConfig.read()).restart !== "idle") return
+    yield* Effect.logInfo("new binary installed; restarting when idle", { binary: command[0] })
+    yield* request(file)
+  }).pipe(Effect.repeat(Schedule.spaced("10 seconds")), Effect.forkScoped)
+})
+
+const registration = Effect.fnUntraced(function* (file: string) {
+  const fs = yield* FileSystem.FileSystem
+  const info = Option.getOrUndefined(
+    decodeRegistration(yield* fs.readFileString(file).pipe(Effect.orElseSucceed(() => ""))),
+  )
+  return info !== undefined && alive(info.pid) ? info : undefined
+})
+
+function alive(pid: number) {
+  try {
+    return process.kill(pid, 0)
+  } catch {
+    return false
+  }
+}
